<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Omni.Windows.App.Features.Diagnostics.DiagnosticsSectionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="using:Omni.Windows.App.Features.Shared" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
  <!-- Laid out like Settings (owner, 2026-10-11): sections on the left, one on the right. The right side
       remade 2026-10-13 like Settings: facts as rows (name left, value right — Shared.FactRows follows
       the hidden source TextBlocks the code writes), tools as setting rows; «Данные для проверки» and
       «Ядро» became one «Инструменты». -->
  <Grid x:Name="DiagnosticsSectionRoot" Visibility="Collapsed" Background="{ThemeResource OmniBgAppBrush}">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="DiagnosticsNarrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="DiagnosticsContentBorder.Padding" Value="20,16,20,32" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="DiagnosticsWide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900" />
          </VisualState.StateTriggers>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="DiagnosticsNavColumn" Width="275" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Padding="8,3,8,12" Background="{ThemeResource OmniBgPanelBrush}" BorderBrush="{ThemeResource OmniStrokeBrush}" BorderThickness="0,0,1,0">
      <StackPanel Spacing="12">
        <Grid MinHeight="40">
          <TextBlock VerticalAlignment="Center" Style="{StaticResource CardTitleTextStyle}" Text="Диагностика" />
        </Grid>
        <ListView x:Name="DiagnosticsNavList" SelectionMode="Single" AutomationProperties.AutomationId="DiagnosticsNavList">
          <ListViewItem Content="Сеть" Tag="network" />
          <ListViewItem Content="Доставка" Tag="delivery" />
          <ListViewItem Content="Безопасность" Tag="security" />
          <ListViewItem Content="Медиа" Tag="video" />
          <ListViewItem Content="Инструменты" Tag="tools" />
        </ListView>
      </StackPanel>
    </Border>

    <!-- What the code writes (MainWindow.Transport / Refresh / Chats.Header, CallVideoService, the test
         channel reads them); shown as rows on the pages below. -->
    <StackPanel Visibility="Collapsed">
      <TextBlock x:Name="TransportDiagnosticsTextBlock" />
      <TextBlock x:Name="QueueDiagnosticsTextBlock" />
      <TextBlock x:Name="SecurityDiagnosticsTextBlock" />
      <TextBlock x:Name="CallVideoDiagnosticsTextBlock" AutomationProperties.AutomationId="CallVideoDiagnosticsTextBlock" Text="Медиа: выкл." />
      <TextBlock x:Name="ChatSessionStateTextBlock" Text="Сессия: ожидание" />
      <TextBlock x:Name="ChatSessionLatencyTextBlock" Text="Пинг: — • Последняя активность: —" />
      <TextBlock x:Name="ChatSessionNetworkTextBlock" Text="Сеть: — • Endpoint: —" />
    </StackPanel>

    <ScrollViewer x:Name="DiagnosticsContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
      <!-- One page width whatever the content: up to 884 with the padding, left; narrower with the window. -->
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="884" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Border x:Name="DiagnosticsContentBorder" Padding="32,16,32,40">
        <Grid>
          <StackPanel x:Name="DiagnosticsSection_network" Visibility="Collapsed">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Сеть" />
            <StackPanel x:Name="TransportFactsPanel" Margin="0,12,0,0" />
          </StackPanel>

          <StackPanel x:Name="DiagnosticsSection_delivery" Visibility="Collapsed">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Доставка" />
            <StackPanel x:Name="QueueFactsPanel" Margin="0,12,0,0" />
          </StackPanel>

          <StackPanel x:Name="DiagnosticsSection_security" Visibility="Collapsed">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Безопасность" />
            <StackPanel x:Name="SecurityFactsPanel" Margin="0,12,0,0" />
            <!-- The open chat's session (state / ping / network / endpoint), moved here from the chat
                 header 2026-10-10. -->
            <Border x:Name="ChatSessionInfoBorder" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Style="{StaticResource SettingGroupTitleTextStyle}" Text="Открытый чат" />
                <StackPanel x:Name="ChatSessionStateFactsPanel" />
                <StackPanel x:Name="ChatSessionLatencyFactsPanel" />
                <StackPanel x:Name="ChatSessionNetworkFactsPanel" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="DiagnosticsSection_video" Visibility="Collapsed">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Медиа" />
            <TextBlock Style="{StaticResource SettingCaptionTextStyle}" Margin="0,8,0,0" Text="Что делает звонок прямо сейчас: устройства, кодек, задержка, эхоподавление." />
            <StackPanel x:Name="CallVideoFactsPanel" Margin="0,8,0,0" />
          </StackPanel>

          <StackPanel x:Name="DiagnosticsSection_tools" Visibility="Collapsed">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Инструменты" />
            <TextBlock Style="{StaticResource SettingGroupTitleTextStyle}" Text="Сверка с собеседником" />
            <shared:SettingRow Header="Ваши данные для ручной сверки" Description="Аккаунт, устройства и отпечаток ключа — сравните с тем, что видит собеседник.">
              <shared:SettingRow.Details>
                <TextBox x:Name="MyVerificationPayloadTextBox" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" IsReadOnly="True" MinHeight="160" TextWrapping="Wrap" />
              </shared:SettingRow.Details>
            </shared:SettingRow>

            <TextBlock Style="{StaticResource SettingGroupTitleTextStyle}" Text="Проверка на одном компьютере" />
            <shared:SettingRow Header="Второе окно" Description="Отдельный профиль на этом же компьютере — проверить чат и звонок без второй машины.">
              <Button x:Name="DiagnosticsOpenIsolatedWindowButton" Content="Открыть" />
              <shared:SettingRow.Details>
                <TextBlock x:Name="DiagnosticsToolsStatusTextBlock" Style="{StaticResource SettingCaptionTextStyle}" />
              </shared:SettingRow.Details>
            </shared:SettingRow>
            <shared:SettingRow Header="Ядро отвечает?" Description="Короткий вызов ядра.">
              <Button x:Name="DiagnosticsPingButton" Content="Проверить" />
              <shared:SettingRow.Details>
                <TextBlock x:Name="DiagnosticsPingStatusTextBlock" Style="{StaticResource SettingCaptionTextStyle}" />
              </shared:SettingRow.Details>
            </shared:SettingRow>
          </StackPanel>
        </Grid>
      </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
