<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="Omni.Windows.App.Features.Workspaces.WorkspacesSectionControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="using:Omni.Windows.App.Features.Workspaces"
  xmlns:shared="using:Omni.Windows.App.Features.Shared"
  Visibility="Collapsed"
  mc:Ignorable="d">

  <!-- Workspaces — groups with git repositories (docs/decisions/omni-workspace-ux.md), a section of
       their own beside Chats and Contacts (owner, 2026-10-30): the list on the left like the chats',
       the workspace's code on the right. Its chat stays the group's chat in Chats («Чат»). A folder
       dropped on the list makes a new workspace of it, on a workspace — adds the repository. -->
  <UserControl.Resources>
    <Style x:Key="WorkspaceCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource OmniBgElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource OmniStrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18,14,18,16" />
    </Style>
    <!-- A project in the list: the whole row is the door to its page (a plain button's plate and
         hover, laid out as a row). -->
    <Style x:Key="WorkspaceProjectRowStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="14,10,14,10" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <!-- The hairline between the section's places and an open project's name on the places' strip. -->
    <Style x:Key="WorkspacePlaceHairlineStyle" TargetType="Border">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="24" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{ThemeResource OmniStrokeBrush}" />
    </Style>
    <!-- A line of «Что нового» that leads to its place: quiet until pointed at. -->
    <Style x:Key="WorkspaceNewsRowStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,6,8,6" />
      <Setter Property="Margin" Value="-8,0,-8,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- A discussion in the list of discussions: a row like a line of «Что нового»; the one open is
         tinted. -->
    <Style x:Key="WorkspaceTalkRowStyle" TargetType="Button" BasedOn="{StaticResource WorkspaceNewsRowStyle}">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="10,8,10,8" />
    </Style>
    <Style x:Key="WorkspaceTalkRowOnStyle" TargetType="Button" BasedOn="{StaticResource WorkspaceTalkRowStyle}">
      <Setter Property="Background" Value="{ThemeResource OmniAccentSoftBrush}" />
    </Style>
    <!-- A line of a discussion: the bubble of the group's chat (GroupConversationControl.xaml). -->
    <!-- A project's own tabs: one bordered strip of segments, so they never read as the section's
         places above them. -->
    <Style x:Key="WorkspaceSegmentsStyle" TargetType="Border">
      <Setter Property="BorderBrush" Value="{ThemeResource OmniStrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="WorkspaceSegmentStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="Padding" Value="14,5,14,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="WorkspaceSegmentOnStyle" TargetType="Button" BasedOn="{StaticResource WorkspaceSegmentStyle}">
      <Setter Property="Background" Value="{ThemeResource OmniAccentSoftBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- A file project's state the person scans for (changed, waiting, turned down, up to date): a
         soft chip — the tone's tint, its text colour, a thin border of the same hue; square-cornered,
         not a pill. -->
    <Style x:Key="WorkspaceChipStyle" TargetType="Border">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,1,8,2" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="WorkspaceChipSuccessStyle" TargetType="Border" BasedOn="{StaticResource WorkspaceChipStyle}">
      <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style x:Key="WorkspaceChipCautionStyle" TargetType="Border" BasedOn="{StaticResource WorkspaceChipStyle}">
      <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="WorkspaceChipCriticalStyle" TargetType="Border" BasedOn="{StaticResource WorkspaceChipStyle}">
      <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>
    <!-- Omni's accent, not the system's (on some machines that one is grey). -->
    <Style x:Key="WorkspaceChipAccentStyle" TargetType="Border" BasedOn="{StaticResource WorkspaceChipStyle}">
      <Setter Property="Background" Value="{ThemeResource OmniAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource OmniAccentBrush}" />
    </Style>
    <!-- Neutral: a fact, not a call (no folder here); and a task's own label. -->
    <Style x:Key="WorkspaceChipNeutralStyle" TargetType="Border" BasedOn="{StaticResource WorkspaceChipStyle}">
      <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource OmniStrokeBrush}" />
    </Style>
    <Style x:Key="WorkspaceChipTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="WorkspaceChipSuccessTextStyle" TargetType="TextBlock" BasedOn="{StaticResource WorkspaceChipTextStyle}">
      <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style x:Key="WorkspaceChipCautionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource WorkspaceChipTextStyle}">
      <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="WorkspaceChipCriticalTextStyle" TargetType="TextBlock" BasedOn="{StaticResource WorkspaceChipTextStyle}">
      <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style x:Key="WorkspaceChipNeutralTextStyle" TargetType="TextBlock" BasedOn="{StaticResource WorkspaceChipTextStyle}">
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="WorkspaceChipAccentTextStyle" TargetType="TextBlock" BasedOn="{StaticResource WorkspaceChipTextStyle}">
      <Setter Property="Foreground" Value="{ThemeResource OmniAccentBrush}" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{ThemeResource OmniBgAppBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="WorkspacesListColumn" Width="275" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <!-- The list column's edge: its width is one for every section (Features/Shared/SectionRail.cs). -->
    <shared:RailSplitter Grid.Column="0" Grid.RowSpan="10" />

    <Border
      x:Name="WorkspacesLeftPane"
      Padding="8,3,8,12"
      AllowDrop="True"
      Background="{ThemeResource OmniBgPanelBrush}"
      BorderBrush="{ThemeResource OmniStrokeBrush}"
      BorderThickness="0,0,1,0"
      DragOver="OnFolderDragOver"
      Drop="OnListDrop">
      <Grid RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- The top as the chat list's: the title with its one button, the search under it. -->
        <StackPanel Spacing="4">
          <Grid>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource CardTitleTextStyle}" Text="Workspaces" />
            <Button
              x:Name="NewWorkspaceButton"
              Style="{StaticResource PaneHeaderButtonStyle}"
              AutomationProperties.Name="Новый workspace"
              Click="OnNewWorkspaceClicked"
              ToolTipService.ToolTip="Новый workspace из папки с git-репозиторием">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="12" Glyph="&#xE710;" />
                <TextBlock Text="Workspace" />
              </StackPanel>
            </Button>
          </Grid>
          <TextBox x:Name="WorkspaceSearchBox" PlaceholderText="Поиск" TextChanged="OnSearchChanged" />
        </StackPanel>
        <!-- The row of the chat and contact lists (App.xaml, PersonRowTemplate). -->
        <ListView
          x:Name="WorkspacesList"
          Grid.Row="1"
          ItemContainerStyle="{StaticResource PersonListItemStyle}"
          ItemTemplate="{StaticResource PersonRowTemplate}"
          SelectionChanged="OnWorkspaceSelected"
          Style="{StaticResource PersonListViewStyle}" />
        <!-- No workspace yet: what it is and the two ways to make one. -->
        <StackPanel
          x:Name="WorkspacesEmptyHint"
          Grid.Row="1"
          Margin="8,8,8,0"
          Spacing="8"
          Visibility="Collapsed">
          <TextBlock Opacity="0.8" TextWrapping="Wrap" Text="Workspace — общий проект группы: код (git) или файлы — модели, чертежи, документы. Подключите рабочую папку — она будет держать последнюю версию — или скачивайте нужные файлы по одному." />
          <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap" Text="Нажмите «+ Workspace» или перетащите сюда папку проекта." />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The selected workspace. -->
    <Grid
      x:Name="WorkspacePage"
      Grid.Column="1"
      AllowDrop="True"
      DragLeave="OnFolderDragLeave"
      DragOver="OnFolderDragOver"
      Drop="OnPageDrop"
      Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <shared:ConversationHeader x:Name="WorkspaceHeader">
        <shared:ConversationHeader.Actions>
          <!-- Icons, as a chat's and a group's header has. -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
              x:Name="WorkspaceChatButton"
              AutomationProperties.Name="Чат"
              Click="OnOpenChatClicked"
              Style="{StaticResource GhostIconButtonStyle}"
              ToolTipService.ToolTip="Чат группы workspace">
              <FontIcon FontSize="16" Glyph="&#xE8BD;" />
            </Button>
            <Button
              x:Name="WorkspaceInviteButton"
              AutomationProperties.Name="Пригласить"
              Click="OnInviteClicked"
              Style="{StaticResource GhostIconButtonStyle}"
              ToolTipService.ToolTip="Пригласить участников">
              <FontIcon FontSize="16" Glyph="&#xE8FA;" />
            </Button>
          </StackPanel>
        </shared:ConversationHeader.Actions>
      </shared:ConversationHeader>

      <!-- The hairline right under the header, as a chat's (y 48): the bars sit under it and take no
           room while closed (owner, 2026-10-30: the line stood 16 px lower than in the chats). -->
      <Grid Grid.Row="1" BorderBrush="{ThemeResource OmniStrokeBrush}" BorderThickness="0,1,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="WorkspacePlaceColumn" Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- The section's places: the projects (and a project's page), the tasks board, the agents. -->
        <!-- 38 on the right: the page's 24 and what its scroll bar keeps, so the actions end where it does. -->
        <Grid Margin="16,4,38,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <SelectorBar x:Name="WorkspaceSwitcher" SelectionChanged="OnSwitcherChanged">
            <SelectorBarItem x:Name="WorkspaceOverviewTab" IsSelected="True" Text="Обзор" />
            <SelectorBarItem x:Name="WorkspaceProjectsTab" Text="Проекты" />
            <SelectorBarItem x:Name="WorkspaceTasksTab" Text="Задачи" />
            <SelectorBarItem x:Name="WorkspaceTalkTab" Text="Обсуждения" />
            <SelectorBarItem x:Name="WorkspaceAgentsTab" Text="Агенты" />
          </SelectorBar>
          <!-- An open project: a hairline after the places, its name and its own tabs. -->
          <StackPanel
            x:Name="WorkspacePlaceTitle"
            Grid.Column="1"
            Margin="16,0,16,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="16" />
          <!-- What the last action did: a small line before the actions, not a bar over the page. -->
          <ContentControl
            x:Name="WorkspaceStatusHost"
            Grid.Column="1"
            Margin="0,0,12,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            IsTabStop="False" />
        </Grid>
        <!-- The place's actions and filters: a row of their own under the places, from the left edge,
             next to what they act on — not at the far end of the places' strip, where on a narrow
             window «Новая задача» went off the edge (docs/decisions/omni-app-ux.md R4). -->
        <shared:WrapRow
          x:Name="WorkspacePlaceActions"
          Grid.Row="1"
          Margin="24,10,38,2"
          HorizontalAlignment="Left"
          Visibility="Collapsed" />


        <ScrollViewer
          x:Name="WorkspaceCardsScroll"
          Grid.Row="2"
          Grid.ColumnSpan="2"
          VerticalScrollBarVisibility="Auto">
          <!-- The projects and a code project's page; each part keeps its own width, from the left. -->
          <StackPanel x:Name="WorkspaceCodePanel" Padding="24,16,24,28" Spacing="16" />
        </ScrollViewer>
        <!-- A files project's page, the tasks, the agents in place of the projects. -->
        <Grid x:Name="WorkspaceProjectHost" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" />
      </Grid>

      <!-- A folder over the page: the same affordance as a file over a chat. -->
      <Border
        x:Name="WorkspaceDropOverlay"
        Grid.RowSpan="2"
        Margin="12"
        Background="{ThemeResource OmniBgElevatedBrush}"
        BorderBrush="{ThemeResource OmniAccentBrush}"
        BorderThickness="2"
        CornerRadius="12"
        IsHitTestVisible="False"
        Opacity="0.92"
        Visibility="Collapsed">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Text="Отпустите папку — она станет папкой проекта: с кодом или с файлами" />
      </Border>
    </Grid>

    <TextBlock
      x:Name="WorkspaceNothingSelected"
      Grid.Column="1"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Opacity="0.6"
      Text="Выберите workspace слева" />
  </Grid>
</UserControl>
