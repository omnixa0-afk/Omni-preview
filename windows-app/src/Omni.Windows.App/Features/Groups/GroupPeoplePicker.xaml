<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="Omni.Windows.App.Features.Groups.GroupPeoplePicker"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shared="using:Omni.Windows.App.Features.Shared"
  xmlns:local="using:Omni.Windows.App.Features.Groups">

  <!-- People picker for "new group" (step 1) and "add to group": search, picked contacts as chips,
       and every approved contact with its avatar and presence dot. Members and already-invited
       contacts are listed greyed out with the reason, so nobody wonders where they went. -->
  <!-- Fixed size (GroupPeoplePicker.BodyWidth/BodyHeight): the dialog must not jump when chips
       appear or when "new group" switches to its name step, which uses the same size. The list takes
       what is left, so chips shrink it instead of growing the dialog. -->
  <Grid x:Name="Root" RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBox
      x:Name="SearchBox"
      PlaceholderText="Поиск контактов"
      TextChanged="OnSearchChanged" />

    <ScrollViewer
      x:Name="ChipsScroll"
      Grid.Row="1"
      HorizontalScrollBarVisibility="Auto"
      HorizontalScrollMode="Enabled"
      VerticalScrollBarVisibility="Disabled"
      VerticalScrollMode="Disabled"
      Visibility="Collapsed">
      <ItemsRepeater x:Name="ChipsRepeater">
        <ItemsRepeater.Layout>
          <StackLayout Orientation="Horizontal" Spacing="6" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="local:GroupPickCandidate">
            <Button
              Padding="4,3,8,3"
              AutomationProperties.Name="{x:Bind Title}"
              Click="OnChipClicked"
              CornerRadius="14"
              Tag="{x:Bind DialogKey}"
              ToolTipService.ToolTip="Убрать">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Width="22" Height="22" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="11">
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Text="{x:Bind Initials}" />
                </Border>
                <TextBlock VerticalAlignment="Center" FontSize="13" Text="{x:Bind Title}" />
                <FontIcon VerticalAlignment="Center" FontSize="9" Glyph="&#xE711;" Opacity="0.7" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </ScrollViewer>

    <Grid Grid.Row="2">
      <ListView
        x:Name="CandidatesList"
        IsItemClickEnabled="True"
        ItemClick="OnCandidateClicked"
        SelectionMode="None">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="local:GroupPickCandidate">
            <Grid Padding="0,6" ColumnSpacing="12" Opacity="{x:Bind RowOpacity}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid Width="40" Height="40">
                <shared:AvatarView Picture="{x:Bind AvatarImage}" PictureTitle="{x:Bind Title}" Size="40" Text="{x:Bind Initials}" />
                <Ellipse
                  Width="11"
                  Height="11"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Fill="{x:Bind PresenceDotBrush}"
                  Stroke="{ThemeResource OmniBgElevatedBrush}"
                  StrokeThickness="2"
                  Visibility="{x:Bind PresenceDotVisibility}" />
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="12" Opacity="0.7" Text="{x:Bind StateText}" Visibility="{x:Bind StateTextVisibility}" />
              </StackPanel>
              <Grid Grid.Column="2" Width="22" Height="22" VerticalAlignment="Center" Visibility="{x:Bind IsSelectable}">
                <Ellipse Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" />
                <Grid Visibility="{x:Bind CheckVisibility, Mode=OneWay}">
                  <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                  <FontIcon FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE73E;" />
                </Grid>
              </Grid>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <TextBlock
        x:Name="EmptyText"
        Margin="8,24"
        HorizontalAlignment="Center"
        Opacity="0.7"
        TextAlignment="Center"
        TextWrapping="Wrap"
        Visibility="Collapsed" />
    </Grid>
  </Grid>
</UserControl>
