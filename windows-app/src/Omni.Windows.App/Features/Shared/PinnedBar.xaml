<?xml version="1.0" encoding="utf-8"?>
<!-- The strip over a conversation's feed: the pinned message; a tap goes to it and on to the next. -->
<UserControl
  x:Class="Omni.Windows.App.Features.Shared.PinnedBar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  IsTabStop="False"
  Visibility="Collapsed">
  <Grid
    Background="{ThemeResource OmniBgPanelBrush}"
    BorderBrush="{ThemeResource OmniStrokeBrush}"
    BorderThickness="0,1,0,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Button
      Padding="16,6,8,6"
      HorizontalAlignment="Stretch"
      HorizontalContentAlignment="Stretch"
      AutomationProperties.Name="Перейти к закреплённому сообщению"
      Background="Transparent"
      BorderThickness="0"
      Click="OnOpenClicked"
      CornerRadius="0">
      <Border Padding="8,0,0,0" BorderBrush="{ThemeResource OmniAccentBrush}" BorderThickness="2,0,0,0">
        <StackPanel>
          <TextBlock
            x:Name="TitlePart"
            FontSize="12"
            FontWeight="SemiBold"
            Foreground="{ThemeResource OmniAccentBrush}" />
          <TextBlock
            x:Name="TextPart"
            FontSize="13"
            Foreground="{ThemeResource OmniTextBrush}"
            MaxLines="1"
            TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </Button>
    <Button
      Grid.Column="1"
      Width="36"
      Height="36"
      MinWidth="0"
      MinHeight="0"
      Margin="0,0,8,0"
      Padding="0"
      VerticalAlignment="Center"
      AutomationProperties.Name="Открепить"
      Background="Transparent"
      BorderThickness="0"
      Click="OnUnpinClicked"
      ToolTipService.ToolTip="Открепить">
      <FontIcon FontSize="14" Glyph="&#xE711;" />
    </Button>
  </Grid>
</UserControl>
