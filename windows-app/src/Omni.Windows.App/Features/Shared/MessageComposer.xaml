<?xml version="1.0" encoding="utf-8"?>
<!-- One composer for every conversation (owner, 2026-10-11: «строка в группе и 1 на 1 отличается,
     надо по 1 макету»): the host's lines over the field (a status), the file about to go, the
     paperclip, the field, the round send. Enter sends, Shift+Enter is a new line, as in Telegram. -->
<UserControl
  x:Class="Omni.Windows.App.Features.Shared.MessageComposer"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shared="using:Omni.Windows.App.Features.Shared"
  IsTabStop="False">
  <!-- A slim row (owner, 2026-10-12: «подсузить в высоту»): 6 + 36 + 6. -->
  <Border
    Padding="12,6"
    Background="{ThemeResource OmniBgPanelBrush}"
    BorderBrush="{ThemeResource OmniStrokeBrush}"
    BorderThickness="0,1,0,0">
    <StackPanel>
      <ContentPresenter x:Name="AbovePart" />
      <!-- The file about to go: a picture shows itself and offers «Сжать как фото». -->
      <Border
        x:Name="DraftPart"
        Margin="0,0,0,8"
        Padding="10"
        Background="{ThemeResource OmniBgElevatedBrush}"
        BorderBrush="{ThemeResource OmniStrokeBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Visibility="Collapsed">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Width="48" Height="48">
            <Border
              x:Name="DraftFileIconPart"
              Background="{ThemeResource AccentFillColorSecondaryBrush}"
              CornerRadius="24">
              <FontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="18"
                Glyph="&#xE130;" />
            </Border>
            <shared:PhotoView x:Name="DraftThumbnailPart" DecodeWidth="96" Visibility="Collapsed" />
          </Grid>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock x:Name="DraftNamePart" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
            <TextBlock x:Name="DraftSizePart" FontSize="12" Opacity="0.76" />
            <!-- Telegram's «Сжать изображение»: ticked, the picture goes as a photo. -->
            <CheckBox
              x:Name="DraftAsPhotoPart"
              MinHeight="0"
              Padding="6,0,0,0"
              AutomationProperties.AutomationId="DraftAttachmentAsPhotoCheckBox"
              Checked="OnDraftAsPhotoToggled"
              Content="Сжать как фото"
              FontSize="12"
              Unchecked="OnDraftAsPhotoToggled"
              Visibility="Collapsed" />
          </StackPanel>
          <Button
            x:Name="DraftRemovePart"
            Grid.Column="2"
            AutomationProperties.Name="Убрать вложение"
            Click="OnDraftRemoveClicked"
            Style="{StaticResource GhostIconButtonStyle}">
            <FontIcon FontSize="14" Glyph="&#xE711;" />
          </Button>
        </Grid>
      </Border>
      <Grid MinHeight="36" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button
          x:Name="AttachPart"
          Width="36"
          Height="36"
          VerticalAlignment="Bottom"
          AutomationProperties.Name="Прикрепить файл"
          Click="OnAttachClicked"
          Style="{StaticResource GhostIconButtonStyle}">
          <FontIcon FontSize="16" Glyph="&#xE723;" />
        </Button>
        <TextBox
          x:Name="InputPart"
          Grid.Column="1"
          MinHeight="34"
          MaxHeight="148"
          Padding="12,6"
          VerticalAlignment="Center"
          AcceptsReturn="True"
          PlaceholderText="Сообщение"
          PreviewKeyDown="OnInputPreviewKeyDown"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          TextWrapping="Wrap" />
        <Button
          x:Name="SendPart"
          Grid.Column="2"
          Width="36"
          Height="36"
          VerticalAlignment="Bottom"
          AutomationProperties.Name="Отправить"
          Click="OnSendClicked"
          CornerRadius="18"
          Style="{StaticResource AccentCircleIconButtonStyle}">
          <FontIcon FontSize="16" Foreground="{ThemeResource OmniAccentBrush}" Glyph="&#xE122;" />
        </Button>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
