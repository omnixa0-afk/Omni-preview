<?xml version="1.0" encoding="utf-8"?>
<!-- Where to forward: search, «Все / Личные / Группы», and the conversations, recent first. A press sends
     there at once; with Ctrl it marks several, and then the dialog offers to send to them. -->
<UserControl
  x:Class="Omni.Windows.App.Features.Shared.ForwardPicker"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shared="using:Omni.Windows.App.Features.Shared"
  IsTabStop="False">
  <Grid RowSpacing="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBox x:Name="SearchPart" PlaceholderText="Поиск" TextChanged="OnSearchChanged" />
    <SelectorBar x:Name="TabsPart" Grid.Row="1" SelectionChanged="OnTabChanged">
      <SelectorBarItem IsSelected="True" Text="Все" />
      <SelectorBarItem Text="Личные" />
      <SelectorBarItem Text="Группы" />
    </SelectorBar>
    <ListView
      x:Name="ListPart"
      Grid.Row="2"
      Margin="-12,0"
      IsItemClickEnabled="True"
      ItemClick="OnRowClicked"
      SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="shared:ForwardChoice">
          <Grid Padding="0,5" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <shared:AvatarView
              Fill="{x:Bind AvatarBrush}"
              OpensPicture="False"
              Picture="{x:Bind AvatarImage}"
              PictureTitle="{x:Bind Title}"
              Size="42"
              Text="{x:Bind Initials}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock
                FontSize="12"
                Foreground="{ThemeResource OmniMutedTextBrush}"
                Text="{x:Bind Subtitle}"
                TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Grid
              Grid.Column="2"
              Width="22"
              Height="22"
              VerticalAlignment="Center"
              Visibility="{x:Bind PickedVisibility, Mode=OneWay}">
              <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
              <FontIcon FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE73E;" />
            </Grid>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <TextBlock
      x:Name="EmptyPart"
      Grid.Row="2"
      Margin="8,24"
      HorizontalAlignment="Center"
      Foreground="{ThemeResource OmniMutedTextBrush}"
      Text="Никого не нашлось"
      Visibility="Collapsed" />
  </Grid>
</UserControl>
