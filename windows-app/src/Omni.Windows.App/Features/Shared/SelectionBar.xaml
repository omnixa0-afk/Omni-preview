<?xml version="1.0" encoding="utf-8"?>
<!-- In the conversation header's place while messages are being picked, as in Telegram (owner,
     2026-11-06): how many, and what to do with them. Same height, so the feed does not move. -->
<UserControl
  x:Class="Omni.Windows.App.Features.Shared.SelectionBar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  IsTabStop="False"
  Visibility="Collapsed">
  <Grid
    Padding="16,0,8,0"
    Background="{ThemeResource OmniBgPanelBrush}"
    ColumnSpacing="4">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock x:Name="CountPart" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
    <Button Grid.Column="1" Click="OnCopyClicked" Style="{StaticResource PaneHeaderButtonStyle}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <FontIcon FontSize="13" Glyph="&#xE8C8;" />
        <TextBlock Text="Копировать" />
      </StackPanel>
    </Button>
    <Button Grid.Column="2" Click="OnForwardClicked" Style="{StaticResource PaneHeaderButtonStyle}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <FontIcon FontSize="13" Glyph="&#xE72A;" />
        <TextBlock Text="Переслать" />
      </StackPanel>
    </Button>
    <Button Grid.Column="3" Click="OnDeleteClicked" Style="{StaticResource PaneHeaderButtonStyle}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <FontIcon FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE74D;" />
        <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="Удалить" />
      </StackPanel>
    </Button>
    <Button
      Grid.Column="4"
      Width="32"
      Height="32"
      MinWidth="0"
      MinHeight="0"
      Padding="0"
      AutomationProperties.Name="Отменить выбор"
      Background="Transparent"
      BorderThickness="0"
      Click="OnCancelClicked">
      <FontIcon FontSize="13" Glyph="&#xE711;" />
    </Button>
  </Grid>
</UserControl>
