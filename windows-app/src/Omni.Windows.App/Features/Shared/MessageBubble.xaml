<?xml version="1.0" encoding="utf-8"?>
<!-- One message, in every conversation: a 1:1 chat, a group, a discussion (owner, 2026-11-04: «всё,
     что исполняет одну функцию, из одного шаблона»). Draws a MessageRow; a new part of a message goes
     here and into MessageRow, and nowhere else. -->
<UserControl
  x:Class="Omni.Windows.App.Features.Shared.MessageBubble"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:chats="using:Omni.Windows.App.Features.Chats"
  xmlns:shared="using:Omni.Windows.App.Features.Shared"
  IsTabStop="False">
  <UserControl.Resources>
    <chats:ChatBubbleBrushConverter x:Key="BubbleBrushConverter" />
    <Style x:Key="MessageMenuItemStyle" TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <!-- «Сегодня» / «8 октября» over the first message of a day. -->
    <Border
      Margin="0,4,0,12"
      Padding="10,3"
      HorizontalAlignment="Center"
      Background="{ThemeResource OmniBgElevatedBrush}"
      CornerRadius="10"
      x:Name="DayHeaderPart"
            x:Load="{x:Bind IsShown(Row.DayHeaderVisibility), Mode=OneWay}">
      <TextBlock
        FontSize="12"
        Foreground="{ThemeResource OmniMutedTextBrush}"
        Text="{x:Bind Row.DayHeaderText, Mode=OneWay}" />
    </Border>
    <!-- A line of the conversation itself: «X в группе». -->
    <Border
      Margin="0,0,0,10"
      Padding="10,4"
      HorizontalAlignment="Center"
      Background="{ThemeResource OmniBgElevatedBrush}"
      CornerRadius="10"
      x:Name="SystemPart"
            x:Load="{x:Bind IsShown(Row.SystemVisibility), Mode=OneWay}">
      <TextBlock
        FontSize="12"
        Foreground="{ThemeResource OmniMutedTextBrush}"
        Text="{x:Bind Row.SystemText, Mode=OneWay}"
        TextWrapping="Wrap" />
    </Border>
    <Grid ColumnSpacing="8" Visibility="{x:Bind Row.BubbleVisibility, Mode=OneWay}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <!-- While messages are being picked: its circle; a tap anywhere on the row picks it. -->
      <Grid
        Width="22"
        Height="22"
        Margin="0,0,0,10"
        VerticalAlignment="Center"
        Visibility="{x:Bind Row.SelectingVisibility, Mode=OneWay}">
        <Ellipse Stroke="{ThemeResource OmniMutedTextBrush}" StrokeThickness="1.5" />
        <Grid Visibility="{x:Bind Row.SelectedVisibility, Mode=OneWay}">
          <Ellipse Fill="{ThemeResource OmniAccentBrush}" />
          <FontIcon FontSize="12" Foreground="White" Glyph="&#xE73E;" />
        </Grid>
      </Grid>
      <!-- The author's avatar at the foot of each incoming run. -->
      <shared:AvatarView
        Grid.Column="1"
        Margin="0,0,0,10"
        VerticalAlignment="Bottom"
        Fill="{x:Bind Row.Peer.AvatarBrush, Mode=OneWay}"
        Opacity="{x:Bind Row.AvatarOpacity, Mode=OneWay}"
        Picture="{x:Bind Row.Peer.AvatarImage, Mode=OneWay}"
        PictureTitle="{x:Bind Row.SenderName, Mode=OneWay}"
        Size="34"
        Text="{x:Bind Row.Peer.AvatarText, Mode=OneWay}"
        Visibility="{x:Bind Row.AvatarSlotVisibility, Mode=OneWay}" />
      <Border
        x:Name="BubblePart"
        Grid.Column="2"
        MaxWidth="{x:Bind Row.BubbleMaxWidth, Mode=OneWay}"
        Margin="{x:Bind Row.BubbleMargin, Mode=OneWay}"
        Padding="{x:Bind Row.BubblePadding, Mode=OneWay}"
        HorizontalAlignment="{x:Bind Row.BubbleHorizontalAlignment, Mode=OneWay}"
        Background="{x:Bind BubbleFill(Row.IsOutgoing, Row.IsVideoNote), Mode=OneWay}"
        BorderBrush="{ThemeResource OmniBubbleStrokeBrush}"
        BorderThickness="{x:Bind Row.BubbleBorderThickness, Mode=OneWay}"
        CornerRadius="12">
        <Border.ContextFlyout>
          <!-- The message's menu, wherever on it the right click lands: emoji on top, as in Telegram. -->
          <Flyout x:Name="MenuPart" Opening="OnMenuOpening">
            <Flyout.FlyoutPresenterStyle>
              <Style TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="4" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
            </Flyout.FlyoutPresenterStyle>
            <!-- Made on the first right click (MessageBubble.EnsureMenu): some fifteen buttons on every
                 row of a feed made opening a group slow and heavy (owner, 2026-11-06). -->
            <Border>
            <StackPanel x:Name="MenuContentPart" Width="272" Spacing="2" x:Load="False">
              <StackPanel x:Name="ReactionsMenuPart" Spacing="2">
                <StackPanel x:Name="QuickEmojiPart" Orientation="Horizontal" Spacing="2" />
                <shared:WrapRow x:Name="AllEmojiPart" Spacing="2" Visibility="Collapsed" />
                <Rectangle Height="1" Margin="4,3" Fill="{ThemeResource OmniStrokeBrush}" />
              </StackPanel>
              <Button x:Name="ReplyItem" Click="OnReplyClicked" Style="{StaticResource MessageMenuItemStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <FontIcon FontSize="16" Glyph="&#xE97A;" />
                  <TextBlock Text="Ответить" />
                </StackPanel>
              </Button>
              <Button x:Name="CopyItem" Click="OnCopyClicked" Style="{StaticResource MessageMenuItemStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                  <TextBlock x:Name="CopyItemText" Text="Копировать текст" />
                </StackPanel>
              </Button>
              <Button x:Name="CopyImageItem" Click="OnCopyImageClicked" Style="{StaticResource MessageMenuItemStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <FontIcon FontSize="16" Glyph="&#xE8B9;" />
                  <TextBlock Text="Копировать изображение" />
                </StackPanel>
              </Button>
              <Button x:Name="PinItem" Click="OnPinClicked" Style="{StaticResource MessageMenuItemStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <FontIcon x:Name="PinItemIcon" FontSize="16" Glyph="&#xE718;" />
                  <TextBlock x:Name="PinItemText" Text="Закрепить" />
                </StackPanel>
              </Button>
              <Button x:Name="OpenPhotoItem" Click="OnPhotoOpenItemClicked" Style="{StaticResource MessageMenuItemStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <FontIcon FontSize="16" Glyph="&#xE8A7;" />
                  <TextBlock Text="Открыть" />
                </StackPanel>
              </Button>
              <Button x:Name="SavePhotoItem" Click="OnPhotoSaveItemClicked" Style="{StaticResource MessageMenuItemStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <FontIcon FontSize="16" Glyph="&#xE896;" />
                  <TextBlock Text="Сохранить как…" />
                </StackPanel>
              </Button>
              <Button x:Name="ForwardItem" Click="OnForwardClicked" Style="{StaticResource MessageMenuItemStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <FontIcon FontSize="16" Glyph="&#xE72A;" />
                  <TextBlock Text="Переслать" />
                </StackPanel>
              </Button>
              <Button x:Name="SelectItem" Click="OnSelectClicked" Style="{StaticResource MessageMenuItemStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <FontIcon FontSize="16" Glyph="&#xE73A;" />
                  <TextBlock Text="Выбрать" />
                </StackPanel>
              </Button>
              <Button x:Name="DeleteItem" Click="OnDeleteClicked" Style="{StaticResource MessageMenuItemStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <FontIcon FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE74D;" />
                  <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="Удалить" />
                </StackPanel>
              </Button>
            </StackPanel>
            </Border>
          </Flyout>
        </Border.ContextFlyout>
        <StackPanel Spacing="2">
          <!-- Who: the author, who they are, what the message is. -->
          <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind Row.AuthorLineVisibility, Mode=OneWay}">
            <TextBlock
              VerticalAlignment="Center"
              FontSize="12"
              FontWeight="SemiBold"
              Foreground="{ThemeResource OmniAccentBrush}"
              Text="{x:Bind Row.SenderName, Mode=OneWay}"
              Visibility="{x:Bind Row.SenderVisibility, Mode=OneWay}" />
            <TextBlock
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{ThemeResource OmniMutedTextBrush}"
              Text="{x:Bind Row.NoteText, Mode=OneWay}"
              Visibility="{x:Bind Row.NoteVisibility, Mode=OneWay}" />
            <TextBlock
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{ThemeResource OmniAccentBrush}"
              Text="{x:Bind Row.ChipText, Mode=OneWay}"
              Visibility="{x:Bind Row.ChipVisibility, Mode=OneWay}" />
          </StackPanel>
          <!-- The answered message, as in Telegram: a strip, whose it is, how it began; a tap goes there. -->
          <Button
            Margin="0,2,0,4"
            Padding="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.Name="Перейти к сообщению"
            Background="Transparent"
            BorderThickness="0"
            Click="OnQuoteClicked"
            x:Name="QuotePart"
            x:Load="{x:Bind IsShown(Row.QuoteVisibility), Mode=OneWay}">
            <Border
              Padding="8,2,6,2"
              BorderBrush="{ThemeResource OmniAccentBrush}"
              BorderThickness="2,0,0,0">
              <StackPanel>
                <TextBlock
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="{ThemeResource OmniAccentBrush}"
                  MaxLines="1"
                  Text="{x:Bind Row.QuoteAuthor, Mode=OneWay}"
                  TextTrimming="CharacterEllipsis" />
                <TextBlock
                  FontSize="12"
                  Foreground="{ThemeResource OmniMutedTextBrush}"
                  MaxLines="1"
                  Text="{x:Bind Row.QuoteText, Mode=OneWay}"
                  TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </Button>
          <!-- A photo: the picture itself; a tap opens it on the whole window. -->
          <Button
            x:Name="PhotoPart"
            Loaded="OnPhotoPartLoaded"
            Margin="-8,-4,-6,2"
            Padding="0"
            AutomationProperties.Name="Фото"
            Background="Transparent"
            BorderThickness="0"
            Click="OnPhotoClicked"
            Tag="{x:Bind Row.MessageId, Mode=OneWay}"
            x:Load="{x:Bind IsShown(Row.PhotoVisibility), Mode=OneWay}">
            <shared:PhotoView
              Width="{x:Bind Row.PhotoDisplayWidth, Mode=OneWay}"
              Height="{x:Bind Row.PhotoDisplayHeight, Mode=OneWay}"
              DecodeWidth="{x:Bind Row.PhotoDecodeWidth, Mode=OneWay}"
              LocalPath="{x:Bind Row.PhotoLocalPath, Mode=OneWay}"
              PreviewBase64="{x:Bind Row.PhotoPreviewBase64, Mode=OneWay}" />
          </Button>
          <!-- A file: an icon, the name, the size and the state, flat in the bubble as in Telegram. -->
          <Button
            Padding="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            Click="OnFileClicked"
            Tag="{x:Bind Row.MessageId, Mode=OneWay}"
            x:Name="FileCardPart"
            x:Load="{x:Bind IsShown(Row.AttachmentFileVisibility), Mode=OneWay}">
            <Grid Padding="0,4" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border
                Width="44"
                Height="44"
                VerticalAlignment="Top"
                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                CornerRadius="22">
                <FontIcon
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="18"
                  Glyph="&#xE130;" />
              </Border>
              <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                  FontWeight="SemiBold"
                  Text="{x:Bind Row.AttachmentFileName, Mode=OneWay}"
                  TextWrapping="Wrap" />
                <TextBlock
                  FontSize="12"
                  Opacity="0.76"
                  Text="{x:Bind Row.AttachmentSizeText, Mode=OneWay}" />
                <TextBlock
                  FontSize="12"
                  Opacity="0.86"
                  Text="{x:Bind Row.AttachmentStatusText, Mode=OneWay}"
                  TextWrapping="Wrap"
                  Visibility="{x:Bind Row.AttachmentStatusVisibility, Mode=OneWay}" />
                <ProgressBar
                  Height="4"
                  Maximum="100"
                  Minimum="0"
                  Visibility="{x:Bind Row.AttachmentProgressVisibility, Mode=OneWay}"
                  Value="{x:Bind Row.AttachmentProgressValue, Mode=OneWay}" />
              </StackPanel>
            </Grid>
          </Button>
          <!-- A video message: a circle with no bubble. Its first frame until pressed, then a player
               goes in over it (VideoNotePlayer); the ring says how far. -->
          <Grid
            x:Name="VideoNotePart"
            Loaded="OnVideoNotePartLoaded"
            Width="{x:Bind CircleSide(Row.VideoNoteSide, shared:VideoNoteSizing.Instance.Limit), Mode=OneWay}"
            Height="{x:Bind CircleSide(Row.VideoNoteSide, shared:VideoNoteSizing.Instance.Limit), Mode=OneWay}"
            AutomationProperties.Name="Видеосообщение"
            Background="{ThemeResource OmniBgElevatedBrush}"
            Tag="{x:Bind Row.MessageId, Mode=OneWay}"
            Tapped="OnVideoNoteTapped"
            x:Load="{x:Bind IsShown(Row.VideoNoteVisibility), Mode=OneWay}">
            <shared:PhotoView DecodeWidth="320" PreviewBase64="{x:Bind Row.VideoNotePreviewBase64, Mode=OneWay}" />
            <!-- How far: a thin line along the edge, from the top, clockwise. -->
            <Ellipse
              Margin="2"
              IsHitTestVisible="False"
              RenderTransformOrigin="0.5,0.5"
              Stroke="{ThemeResource OmniAccentBrush}"
              StrokeDashArray="{x:Bind ProgressDash(Row.VideoNoteProgress, Row.VideoNoteSide, shared:VideoNoteSizing.Instance.Limit), Mode=OneWay}"
              StrokeThickness="3"
              Visibility="{x:Bind Row.VideoNoteProgressVisibility, Mode=OneWay}">
              <Ellipse.RenderTransform>
                <RotateTransform Angle="-90" />
              </Ellipse.RenderTransform>
            </Ellipse>
            <Border
              Width="48"
              Height="48"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="#99000000"
              CornerRadius="24"
              IsHitTestVisible="False"
              Visibility="{x:Bind Row.VideoNotePlaySignVisibility, Mode=OneWay}">
              <FontIcon FontSize="18" Foreground="White" Glyph="&#xE768;" />
            </Border>
            <Border
              Margin="0,0,0,10"
              Padding="8,2"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Background="#99000000"
              CornerRadius="9"
              IsHitTestVisible="False">
              <TextBlock FontSize="12" Foreground="White" Text="{x:Bind Row.VideoNoteTimeText, Mode=OneWay}" />
            </Border>
            <ProgressBar
              Width="120"
              Height="4"
              VerticalAlignment="Center"
              IsHitTestVisible="False"
              Maximum="100"
              Minimum="0"
              Visibility="{x:Bind Row.AttachmentProgressVisibility, Mode=OneWay}"
              Value="{x:Bind Row.AttachmentProgressValue, Mode=OneWay}" />
          </Grid>
          <!-- A voice message: play, the outline (a tap goes to that moment), the time. -->
          <Grid
            MinWidth="210"
            Padding="0,4"
            ColumnSpacing="10"
            x:Name="VoicePart"
            x:Load="{x:Bind IsShown(Row.VoiceVisibility), Mode=OneWay}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
              Width="44"
              Height="44"
              MinWidth="0"
              MinHeight="0"
              Padding="0"
              AutomationProperties.Name="{x:Bind Row.VoiceActionName, Mode=OneWay}"
              Background="{ThemeResource AccentFillColorSecondaryBrush}"
              BorderThickness="0"
              Click="OnVoicePlayClicked"
              CornerRadius="22"
              Tag="{x:Bind Row.MessageId, Mode=OneWay}">
              <FontIcon FontSize="16" Glyph="{x:Bind Row.VoiceGlyph, Mode=OneWay}" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <shared:VoiceWaveform
                x:Name="VoiceWaveformPart"
                BarBrush="{ThemeResource OmniAccentBrush}"
                Bars="{x:Bind Row.VoiceWaveform, Mode=OneWay}"
                Progress="{x:Bind Row.VoiceProgress, Mode=OneWay}"
                Sought="OnVoiceSought" />
              <TextBlock
                FontSize="12"
                Foreground="{ThemeResource OmniMutedTextBrush}"
                Text="{x:Bind Row.VoiceTimeText, Mode=OneWay}" />
              <TextBlock
                FontSize="12"
                Opacity="0.86"
                Text="{x:Bind Row.AttachmentStatusText, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Row.AttachmentStatusVisibility, Mode=OneWay}" />
              <ProgressBar
                Height="4"
                Maximum="100"
                Minimum="0"
                Visibility="{x:Bind Row.AttachmentProgressVisibility, Mode=OneWay}"
                Value="{x:Bind Row.AttachmentProgressValue, Mode=OneWay}" />
            </StackPanel>
          </Grid>
          <!-- The text, under the picture as a caption. It can be selected; its menu is the message's. -->
          <TextBlock
            x:Name="BodyPart"
            AutomationProperties.Name="{x:Bind Row.Body, Mode=OneWay}"
            Foreground="{ThemeResource OmniTextBrush}"
            IsTextSelectionEnabled="True"
            SelectionFlyout="{x:Null}"
            Text="{x:Bind Row.Body, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind Row.BodyVisibility, Mode=OneWay}" />
          <!-- The last line: the emoji on the left (a tap on one's own takes it away, on another's
               joins it), a pin mark, time and ticks in the corner, as in Telegram. -->
          <Grid
            Margin="{x:Bind LastLineMargin(Row.VoiceVisibility, Row.BodyVisibility, Row.ReactionsVisibility, Row.AttachmentStatusVisibility, Row.AttachmentProgressVisibility), Mode=OneWay}"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl
              VerticalAlignment="Bottom"
              IsTabStop="False"
              ItemsSource="{x:Bind Row.Reactions, Mode=OneWay}"
              Visibility="{x:Bind Row.ReactionsVisibility, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <shared:WrapRow Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="shared:MessageReactionChip">
                  <Button
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0"
                    AutomationProperties.Name="{x:Bind AutomationName}"
                    Background="{ThemeResource OmniBgElevatedBrush}"
                    BorderThickness="0"
                    Click="OnReactionChipClicked"
                    CornerRadius="11"
                    Tag="{x:Bind Emoji}"
                    ToolTipService.ToolTip="{x:Bind ToolTip}">
                    <Grid>
                      <Border
                        Background="{ThemeResource OmniAccentBrush}"
                        CornerRadius="11"
                        Opacity="0.28"
                        Visibility="{x:Bind MineVisibility}" />
                      <TextBlock
                        Margin="8,2"
                        FontFamily="{x:Bind shared:EmojiFonts.Family}"
                        FontSize="14"
                        Foreground="{ThemeResource OmniTextBrush}"
                        Text="{x:Bind Label}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <FontIcon
              Grid.Column="1"
              VerticalAlignment="Bottom"
              Margin="8,0,0,2"
              FontSize="10"
              Foreground="{ThemeResource OmniMutedTextBrush}"
              Glyph="&#xE718;"
              IsTextScaleFactorEnabled="False"
              Visibility="{x:Bind Row.PinVisibility, Mode=OneWay}" />
            <TextBlock
              Grid.Column="2"
              Margin="8,0,0,0"
              VerticalAlignment="Bottom"
              FontSize="11"
              Foreground="{ThemeResource OmniMutedTextBrush}"
              Text="{x:Bind Row.TimeText, Mode=OneWay}"
              TextWrapping="Wrap" />
            <Grid
              Grid.Column="3"
              Width="20"
              Height="14"
              VerticalAlignment="Center"
              AutomationProperties.HelpText="{x:Bind Row.DeliveryIndicatorToolTipText, Mode=OneWay}"
              AutomationProperties.Name="{x:Bind Row.DeliveryIndicatorAutomationName, Mode=OneWay}"
              ToolTipService.ToolTip="{x:Bind Row.DeliveryIndicatorToolTipText, Mode=OneWay}"
              Visibility="{x:Bind Row.DeliveryIndicatorVisibility, Mode=OneWay}">
              <Grid Visibility="{x:Bind Row.DeliveryIndicatorNeutralVisibility, Mode=OneWay}">
                <FontIcon
                  Margin="{x:Bind Row.DeliveryPrimaryGlyphMargin, Mode=OneWay}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                  FontSize="11.5"
                  Foreground="{ThemeResource OmniMutedTextBrush}"
                  Glyph="{x:Bind Row.DeliveryPrimaryGlyph, Mode=OneWay}"
                  IsTextScaleFactorEnabled="False" />
                <FontIcon
                  Margin="{x:Bind Row.DeliverySecondaryGlyphMargin, Mode=OneWay}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                  FontSize="11.5"
                  Foreground="{ThemeResource OmniMutedTextBrush}"
                  Glyph="{x:Bind Row.DeliverySecondaryGlyph, Mode=OneWay}"
                  IsTextScaleFactorEnabled="False"
                  Visibility="{x:Bind Row.DeliverySecondaryGlyphVisibility, Mode=OneWay}" />
              </Grid>
              <FontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                FontSize="11.5"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Glyph="{x:Bind Row.DeliveryPrimaryGlyph, Mode=OneWay}"
                IsTextScaleFactorEnabled="False"
                Visibility="{x:Bind Row.DeliveryIndicatorErrorVisibility, Mode=OneWay}" />
            </Grid>
          </Grid>
        </StackPanel>
      </Border>
      <Border
        Grid.ColumnSpan="3"
        Background="Transparent"
        Tapped="OnPickTapped"
        Visibility="{x:Bind Row.SelectingVisibility, Mode=OneWay}" />
    </Grid>
  </StackPanel>
</UserControl>
