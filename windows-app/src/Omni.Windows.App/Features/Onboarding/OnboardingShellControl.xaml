<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="Omni.Windows.App.Features.Onboarding.OnboardingShellControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d">
  <Grid
    x:Name="OnboardingRoot"
    Background="{ThemeResource OmniBgAppBrush}"
    Visibility="Collapsed">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="OnboardingWide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1220" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="OnboardingHeroPanel.(Grid.Row)" Value="0" />
            <Setter Target="OnboardingHeroPanel.(Grid.Column)" Value="0" />
            <Setter Target="OnboardingHeroPanel.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="OnboardingFormPanel.(Grid.Row)" Value="0" />
            <Setter Target="OnboardingFormPanel.(Grid.Column)" Value="1" />
            <Setter Target="OnboardingFormPanel.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="OnboardingLayoutGrid.Padding" Value="68" />
            <Setter Target="OnboardingLayoutGrid.ColumnSpacing" Value="112" />
            <Setter Target="OnboardingLayoutGrid.RowSpacing" Value="24" />
            <Setter Target="OnboardingHeroColumn.Width" Value="78*" />
            <Setter Target="OnboardingFormColumn.Width" Value="122*" />
            <Setter Target="WelcomeActionsPanel.Orientation" Value="Vertical" />
            <Setter Target="RestoreAccountButton.(Grid.Row)" Value="0" />
            <Setter Target="RestoreAccountButton.(Grid.Column)" Value="0" />
            <Setter Target="RestoreAccountButton.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="ImportAccountButton.(Grid.Row)" Value="0" />
            <Setter Target="ImportAccountButton.(Grid.Column)" Value="1" />
            <Setter Target="ImportAccountButton.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="RetryBootButton.HorizontalAlignment" Value="Right" />
            <Setter Target="BootRecoveryActionsPanel.Orientation" Value="Horizontal" />
            <Setter Target="ProfileChooserPrimaryActionsPanel.Orientation" Value="Horizontal" />
            <Setter Target="ProfileChooserSecondaryActionsPanel.Orientation" Value="Horizontal" />
            <Setter Target="CreateActionsPanel.Orientation" Value="Horizontal" />
            <Setter Target="ImportActionsPanel.Orientation" Value="Horizontal" />
            <Setter Target="RecoveryActionsPanel.Orientation" Value="Horizontal" />
            <Setter Target="RestoreActionsPanel.Orientation" Value="Horizontal" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="OnboardingMedium">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="OnboardingHeroPanel.(Grid.Row)" Value="0" />
            <Setter Target="OnboardingHeroPanel.(Grid.Column)" Value="0" />
            <Setter Target="OnboardingHeroPanel.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="OnboardingFormPanel.(Grid.Row)" Value="0" />
            <Setter Target="OnboardingFormPanel.(Grid.Column)" Value="1" />
            <Setter Target="OnboardingFormPanel.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="OnboardingLayoutGrid.Padding" Value="40" />
            <Setter Target="OnboardingLayoutGrid.ColumnSpacing" Value="56" />
            <Setter Target="OnboardingLayoutGrid.RowSpacing" Value="24" />
            <Setter Target="OnboardingHeroColumn.Width" Value="72*" />
            <Setter Target="OnboardingFormColumn.Width" Value="128*" />
            <Setter Target="WelcomeActionsPanel.Orientation" Value="Vertical" />
            <Setter Target="RestoreAccountButton.(Grid.Row)" Value="0" />
            <Setter Target="RestoreAccountButton.(Grid.Column)" Value="0" />
            <Setter Target="RestoreAccountButton.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="ImportAccountButton.(Grid.Row)" Value="0" />
            <Setter Target="ImportAccountButton.(Grid.Column)" Value="1" />
            <Setter Target="ImportAccountButton.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="RetryBootButton.HorizontalAlignment" Value="Right" />
            <Setter Target="BootRecoveryActionsPanel.Orientation" Value="Horizontal" />
            <Setter Target="ProfileChooserPrimaryActionsPanel.Orientation" Value="Horizontal" />
            <Setter Target="ProfileChooserSecondaryActionsPanel.Orientation" Value="Horizontal" />
            <Setter Target="CreateActionsPanel.Orientation" Value="Horizontal" />
            <Setter Target="ImportActionsPanel.Orientation" Value="Horizontal" />
            <Setter Target="RecoveryActionsPanel.Orientation" Value="Horizontal" />
            <Setter Target="RestoreActionsPanel.Orientation" Value="Horizontal" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="OnboardingNarrow">
          <VisualState.Setters>
            <Setter Target="OnboardingHeroPanel.(Grid.Row)" Value="0" />
            <Setter Target="OnboardingHeroPanel.(Grid.Column)" Value="0" />
            <Setter Target="OnboardingHeroPanel.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="OnboardingFormPanel.(Grid.Row)" Value="1" />
            <Setter Target="OnboardingFormPanel.(Grid.Column)" Value="0" />
            <Setter Target="OnboardingFormPanel.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="OnboardingLayoutGrid.Padding" Value="24" />
            <Setter Target="OnboardingLayoutGrid.ColumnSpacing" Value="20" />
            <Setter Target="OnboardingLayoutGrid.RowSpacing" Value="20" />
            <Setter Target="OnboardingHeroColumn.Width" Value="*" />
            <Setter Target="OnboardingFormColumn.Width" Value="*" />
            <Setter Target="WelcomeActionsPanel.Orientation" Value="Vertical" />
            <Setter Target="BootRecoveryActionsPanel.Orientation" Value="Vertical" />
            <Setter Target="ProfileChooserPrimaryActionsPanel.Orientation" Value="Vertical" />
            <Setter Target="ProfileChooserSecondaryActionsPanel.Orientation" Value="Vertical" />
            <Setter Target="CreateActionsPanel.Orientation" Value="Vertical" />
            <Setter Target="ImportActionsPanel.Orientation" Value="Vertical" />
            <Setter Target="RecoveryActionsPanel.Orientation" Value="Vertical" />
            <Setter Target="RestoreActionsPanel.Orientation" Value="Vertical" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid
      x:Name="OnboardingLayoutGrid"
      MaxWidth="1780"
      Padding="24"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      ColumnSpacing="20"
      RowSpacing="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="OnboardingHeroColumn" Width="*" />
        <ColumnDefinition x:Name="OnboardingFormColumn" Width="*" />
      </Grid.ColumnDefinitions>

      <Border
        x:Name="OnboardingHeroPanel"
        Grid.Row="0"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        Padding="8"
        Background="Transparent"
        BorderThickness="0">
        <StackPanel
          MaxWidth="620"
          VerticalAlignment="Center"
          Spacing="18">
          <StackPanel Spacing="14">
            <TextBlock
              FontSize="72"
              FontWeight="SemiBold"
              Text="Omni" />
            <!-- Brand accent bar: the muted Omni slate as a quiet signature under the wordmark. -->
            <Border
              Width="56"
              Height="4"
              HorizontalAlignment="Left"
              Background="{ThemeResource OmniAccentBrush}"
              CornerRadius="2" />
          </StackPanel>
          <TextBlock
            FontSize="30"
            LineHeight="38"
            FontWeight="SemiBold"
            Text="Переписка и звонки — напрямую между людьми."
            TextWrapping="WrapWholeWords" />
          <TextBlock
            MaxWidth="560"
            FontSize="16"
            LineHeight="25"
            Opacity="0.72"
            Text="Без телефона и почты: ваш аккаунт — это ключ, который живёт на ваших устройствах."
            TextWrapping="WrapWholeWords" />
        </StackPanel>
      </Border>

      <ScrollViewer
        x:Name="OnboardingFormPanel"
        Grid.Row="1"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        VerticalAlignment="Center"
        VerticalScrollBarVisibility="Auto">
        <Border
          MaxWidth="860"
          Padding="56"
          HorizontalAlignment="Center"
          Background="{ThemeResource OmniBgPanelBrush}"
          BorderBrush="{ThemeResource OmniStrokeBrush}"
          BorderThickness="1"
          CornerRadius="8">
          <StackPanel Spacing="24">
            <StackPanel Spacing="6">
              <TextBlock
                x:Name="OnboardingTitleTextBlock"
                FontSize="46"
                LineHeight="52"
                FontWeight="SemiBold"
                Text="Добро пожаловать" />
              <TextBlock
                x:Name="OnboardingSubtitleTextBlock"
                FontSize="17"
                LineHeight="25"
                Opacity="0.72"
                Text="Создайте профиль — или верните свой на этот компьютер."
                TextWrapping="WrapWholeWords" />
            </StackPanel>

            <!-- Shown only when there is something to say (an error, «вы вышли»): it repeated the
                 subtitle on every first start (owner, 2026-10-13: UI/UX pass). -->
            <Border
              x:Name="OnboardingStatusBorder"
              Padding="14,12"
              Visibility="Collapsed"
              Background="{ThemeResource OmniBgElevatedBrush}"
              BorderBrush="{ThemeResource OmniStrokeBrush}"
              BorderThickness="1"
              CornerRadius="8">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                  Width="24"
                  Height="24"
                  Background="{ThemeResource OmniAccentSoftBrush}"
                  CornerRadius="12">
                  <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource OmniAccentBrush}"
                    Text="i" />
                </Border>
                <TextBlock
                  x:Name="OnboardingStatusTextBlock"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FontWeight="SemiBold"
                  LineHeight="22"
                  TextWrapping="WrapWholeWords" />
              </Grid>
            </Border>

            <StackPanel
              x:Name="WelcomePanel"
              Spacing="16">
              <StackPanel
                x:Name="WelcomeActionsPanel"
                Spacing="14">
                <Button
                  x:Name="CreateAccountButton"
                  MinHeight="66"
                  HorizontalAlignment="Stretch"
                  FontSize="17"
                  FontWeight="SemiBold"
                  Content="Создать профиль"
                  Style="{StaticResource AccentPrimaryButtonStyle}" />
                <Border
                  Height="1"
                  Margin="0,8,0,0"
                  Background="{ThemeResource OmniStrokeBrush}"
                  Opacity="0.65" />
                <Grid
                  x:Name="WelcomeSecondaryActionsGrid"
                  ColumnSpacing="12"
                  RowSpacing="12">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button
                    x:Name="RestoreAccountButton"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    MinHeight="64"
                    HorizontalAlignment="Stretch"
                    FontWeight="SemiBold"
                    Content="У меня есть фраза восстановления" />
                  <Button
                    x:Name="ImportAccountButton"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    MinHeight="64"
                    HorizontalAlignment="Stretch"
                    FontWeight="SemiBold"
                    Content="Восстановить из резервной копии" />
                </Grid>
                <!-- A failed start has its own panel with its own retry (BootRecoveryPanel). -->
                <Button
                  x:Name="RetryBootButton"
                  Visibility="Collapsed"
                  MinHeight="38"
                  MinWidth="0"
                  Padding="14,6"
                  HorizontalAlignment="Stretch"
                  Content="Повторить запуск" />
              </StackPanel>
            </StackPanel>

            <StackPanel
              x:Name="BootRecoveryPanel"
              Visibility="Collapsed"
              Spacing="16">
              <TextBlock
                Opacity="0.72"
                Text="Локальную базу этого окна не удалось подготовить. Можно удалить локальные данные и начать заново."
                TextWrapping="WrapWholeWords" />
              <Border
                Padding="12"
                Background="{ThemeResource OmniBgElevatedBrush}"
                CornerRadius="12">
                <TextBlock
                  Text="Это удалит локальные данные только у текущего окна. После очистки приложение предложит создать новый профиль."
                  TextWrapping="WrapWholeWords" />
              </Border>
              <StackPanel
                x:Name="BootRecoveryActionsPanel"
                Spacing="12">
                <Button
                  x:Name="BootRecoveryResetButton"
                  Content="Удалить локальные данные и начать заново"
                  Style="{StaticResource DangerButtonStyle}" />
                <Button
                  x:Name="BootRecoveryRetryButton"
                  Content="Повторить запуск" />
              </StackPanel>
            </StackPanel>

            <StackPanel
              x:Name="ProfileChooserPanel"
              Visibility="Collapsed"
              Spacing="12">
              <ListView
                x:Name="SavedProfilesListView"
                MaxHeight="220">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border
                      Margin="0,0,0,8"
                      Padding="10"
                      Background="{ThemeResource OmniBgElevatedBrush}"
                      CornerRadius="10">
                      <StackPanel Spacing="4">
                        <TextBlock
                          FontWeight="SemiBold"
                          TextTrimming="CharacterEllipsis"
                          Text="{Binding DisplayName}" />
                        <TextBlock
                          FontSize="12"
                          Opacity="0.7"
                          Text="{Binding StateLabel}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <StackPanel
                x:Name="ProfileChooserPrimaryActionsPanel"
                Spacing="12">
                <Button
                  x:Name="OpenSavedProfileButton"
                  Content="Войти"
                  Style="{StaticResource AccentPrimaryButtonStyle}" />
                <Button
                  x:Name="DeleteSavedProfileFromChooserButton"
                  Content="Удалить с устройства"
                  Style="{StaticResource DangerButtonStyle}" />
              </StackPanel>
              <StackPanel
                x:Name="ProfileChooserSecondaryActionsPanel"
                Spacing="12">
                <Button
                  x:Name="CreateNewProfileFromChooserButton"
                  Content="Новый профиль" />
                <Button
                  x:Name="RestoreProfileFromChooserButton"
                  Content="У меня есть фраза восстановления" />
                <Button
                  x:Name="ImportProfileFromChooserButton"
                  Content="Восстановить из резервной копии" />
              </StackPanel>
            </StackPanel>

            <StackPanel
              x:Name="UnlockSavedProfilePanel"
              Visibility="Collapsed"
              Spacing="12">
              <TextBlock
                x:Name="UnlockProfileTitleTextBlock"
                FontWeight="SemiBold"
                Text="Вход в сохранённый профиль" />
              <StackPanel Spacing="6">
                <TextBlock Text="Пароль" />
                <PasswordBox x:Name="UnlockPasswordBox" />
                <Button
                  x:Name="UnlockWithPasswordButton"
                  Content="Войти" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="Фраза восстановления" />
                <TextBox
                  x:Name="UnlockMnemonicTextBox"
                  AcceptsReturn="True"
                  MinHeight="88"
                  TextWrapping="Wrap" />
                <Button
                  x:Name="UnlockWithMnemonicButton"
                  Content="Войти по фразе" />
              </StackPanel>
              <Button
                x:Name="BackToChooserButton"
                Content="Назад" />
            </StackPanel>

            <StackPanel
              x:Name="CreateAccountPanel"
              Visibility="Collapsed"
              Spacing="16">
              <StackPanel Spacing="8">
                <TextBlock Text="Ваше имя" />
                <TextBox
                  x:Name="CreateDisplayNameTextBox" MaxLength="64"
                  PlaceholderText="Например, Алексей" />
              </StackPanel>
              <StackPanel Spacing="8">
                <TextBlock Text="Название устройства" />
                <TextBox
                  x:Name="CreateDeviceLabelTextBox" MaxLength="64"
                  PlaceholderText="Например, Домашний ноутбук" />
              </StackPanel>
              <StackPanel
                x:Name="CreateActionsPanel"
                Spacing="12">
                <Button
                  x:Name="CreateAccountExecuteButton"
                  AutomationProperties.AutomationId="CreateAccountExecuteButton"
                  Content="Создать" />
                <Button
                  x:Name="BackToWelcomeFromCreateButton"
                  Content="Назад" />
              </StackPanel>
            </StackPanel>

            <StackPanel
              x:Name="ImportAccountPanel"
              Visibility="Collapsed"
              Spacing="16">
              <TextBlock
                Text="Выберите файл копии и введите фразу — на компьютер вернутся переписка, файлы и контакты."
                TextWrapping="WrapWholeWords" />
              <Border
                Padding="12"
                Background="{ThemeResource OmniBgElevatedBrush}"
                CornerRadius="12">
                <StackPanel Spacing="6">
                  <TextBlock
                    FontWeight="SemiBold"
                    Text="Выбранная резервная копия" />
                  <TextBlock
                    x:Name="ImportAccountFileNameTextBlock"
                    Text="Файл не выбран." />
                  <TextBlock
                    x:Name="ImportAccountFileSummaryTextBlock"
                    TextWrapping="WrapWholeWords" />
                </StackPanel>
              </Border>
              <StackPanel Spacing="8">
                <TextBlock Text="Фраза восстановления" />
                <TextBox
                  x:Name="ImportAccountMnemonicTextBox"
                  AcceptsReturn="True"
                  MinHeight="88"
                  PlaceholderText="Введите фразу восстановления"
                  TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel
                x:Name="ImportActionsPanel"
                Spacing="12">
                <Button
                  x:Name="ChooseImportAccountFileButton"
                  Content="Выбрать файл копии…" />
                <Button
                  x:Name="ImportAccountExecuteButton"
                  Content="Восстановить" />
              </StackPanel>
              <Button
                x:Name="BackToWelcomeFromImportButton"
                Content="Назад" />
              <TextBlock
                x:Name="ImportAccountStatusTextBlock"
                Opacity="0.8"
                Text="Выберите резервную копию и введите фразу восстановления."
                TextWrapping="WrapWholeWords" />
            </StackPanel>

            <StackPanel
              x:Name="RecoveryPanel"
              Visibility="Collapsed"
              Spacing="16">
              <TextBlock
                Text="Запишите слова на бумагу или сохраните в файл — и храните отдельно от этого компьютера. Показать их снова можно в «Настройках → Профиль»."
                TextWrapping="WrapWholeWords" />
              <Border
                Padding="12"
                Background="{ThemeResource OmniBgElevatedBrush}"
                CornerRadius="12">
                <StackPanel Spacing="6">
                  <TextBlock
                    FontWeight="SemiBold"
                    Text="Профиль" />
                  <TextBlock x:Name="RecoveryDisplayNameTextBlock" />
                  <TextBlock x:Name="RecoveryAccountIdTextBlock" />
                </StackPanel>
              </Border>
              <StackPanel Spacing="8">
                <TextBlock Text="Фраза восстановления" />
                <TextBox
                  x:Name="RecoveryPhraseTextBox"
                  IsReadOnly="True" />
              </StackPanel>
              <Expander Header="Технические данные для сохранения">
                <StackPanel Spacing="8">
                  <TextBlock
                    Opacity="0.72"
                    Text="Этот блок нужен только если вы хотите сохранить полное техническое представление профиля вместе с фразой восстановления."
                    TextWrapping="WrapWholeWords" />
                  <TextBox
                    x:Name="RecoveryPayloadTextBox"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    MinHeight="150"
                    TextWrapping="Wrap" />
                </StackPanel>
              </Expander>
              <TextBlock
                x:Name="RecoverySaveStatusTextBlock"
                Opacity="0.8"
                TextWrapping="WrapWholeWords" />
              <StackPanel
                x:Name="RecoveryActionsPanel"
                Spacing="12">
                <Button
                  x:Name="SaveRecoveryToFileButton"
                  Content="Сохранить в файл" />
                <Button
                  x:Name="RecoveryContinueButton"
                  AutomationProperties.AutomationId="RecoveryContinueButton"
                  Content="Фраза сохранена — продолжить" />
              </StackPanel>
            </StackPanel>

            <StackPanel
              x:Name="RestoreAccountPanel"
              Visibility="Collapsed"
              Spacing="16">
              <TextBlock
                Text="24 английских слова, которые вы сохранили при создании профиля."
                TextWrapping="WrapWholeWords" />
              <StackPanel Spacing="8">
                <TextBlock Text="Ваше имя" />
                <TextBox
                  x:Name="RestoreDisplayNameTextBox" MaxLength="64"
                  PlaceholderText="Например, Алексей" />
              </StackPanel>
              <StackPanel Spacing="8">
                <TextBlock Text="Фраза восстановления" />
                <TextBox
                  x:Name="RestoreRecoveryPhraseTextBox"
                  PlaceholderText="Введите фразу восстановления" />
              </StackPanel>
              <StackPanel Spacing="8">
                <TextBlock Text="Название устройства" />
                <TextBox
                  x:Name="RestoreDeviceLabelTextBox" MaxLength="64"
                  PlaceholderText="Например, Рабочий ПК" />
              </StackPanel>
              <StackPanel
                x:Name="RestoreActionsPanel"
                Spacing="12">
                <Button
                  x:Name="RestoreAccountExecuteButton"
                  Content="Восстановить" />
                <Button
                  x:Name="BackToWelcomeFromRestoreButton"
                  Content="Назад" />
              </StackPanel>
              <Border
                Padding="12"
                Background="{ThemeResource OmniBgElevatedBrush}"
                CornerRadius="12">
                <TextBlock
                  x:Name="RestoreScenarioSummaryTextBlock"
                  Text=""
                  TextWrapping="WrapWholeWords" />
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
