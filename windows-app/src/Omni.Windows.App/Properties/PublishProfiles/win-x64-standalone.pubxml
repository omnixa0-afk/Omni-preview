<?xml version="1.0" encoding="utf-8"?>
<!--
  Standalone single-file build: ONE self-contained .exe that runs on a clean Windows 10/11 x64 PC
  with NO installs (no .NET runtime, no Windows App SDK runtime, no VC++ redist).

  Why this works:
   - SelfContained + WindowsAppSDKSelfContained bundle the .NET runtime AND the WinAppSDK runtime.
   - PublishSingleFile + IncludeNativeLibrariesForSelfExtract pack everything (incl. coreclr and the
     native omni_ffi.dll / omni_webrtc_media.dll) into the single exe; they self-extract to
     %TEMP%\.net\Omni\<hash>\ on first launch.
   - Both native DLLs are statically CRT-linked (Rust +crt-static, CMake /MT), so NO vcruntime140 /
     msvcp140 — nothing from the VC++ redistributable is needed.
   - The rendezvous + Mainline-DHT couriers still run as separate CHILD PROCESSES here, with nothing
     unpacked: this exe re-execs ITSELF with the run-helper flag and Core/HelperMode routes that into
     the courier code linked into omni_ffi.dll. Nothing profile-specific is needed for it — the exe
     with no siblings simply takes the self-exec path (see Core/HelperMode.cs).
   - Trimmed in PARTIAL mode: only assemblies that declare themselves trim-safe (the .NET BCL, the
     CsWinRT projections - Microsoft.Windows.SDK.NET.dll, the 24 MB C# projection of the whole Windows
     SDK, being the big one) lose what nothing reaches. Our own Omni.dll is kept whole, so its XAML
     {Binding}s, DisplayMemberPath and ComImport interfaces see every member they did before.
     Full mode would trim Omni.dll too, and those reach members only by name.
   - ReadyToRun goes WITH trimming, not as an extra: the trimmer rewrites the BCL assemblies and so
     drops the native code they ship precompiled, and the trimmed-only exe started slower than the
     untrimmed one. R2R compiles the trimmed set (and Omni.dll, which was never precompiled) again.
     Measured 2026-10-18 on the same machine, window shown after launch:
                         exe       unpacked             first launch   later launches
       untrimmed         91.8 MB   527 files, 206 MB    2.7 s          0.94 s
       trimmed           52.9 MB   156 files, 107 MB    2.9 s          1.28 s
       trimmed + R2R     60.0 MB   157 files, 123 MB    2.3 s          0.60 s

  Build:  dotnet publish windows-app/src/Omni.Windows.App/Omni.Windows.App.csproj -p:PublishProfile=win-x64-standalone
  Ship:   the single Omni.exe from PublishDir. (The .pdb is not produced; nothing else needed.)
  Note:   first launch self-extracts (a few seconds); later launches reuse the extracted folder.
          Each BUILD extracts to its own folder and .NET never removes the old ones (163 of them,
          11 GB, on 2026-10-10): the app removes copies no instance runs from on every start
          (Core/BundleExtractionCleanup.cs).
          The app is portable: it writes its profile db + settings into an OmniData\ folder next to
          the exe (one folder, not a dozen loose files) — copy the pair to move the install.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\x64\publish-standalone\</PublishDir>

    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- PublishTrimmed turns built-in COM interop off by default, and the call video path needs it:
         camera/screen frames are read through [ComImport] IMemoryBufferByteAccess and the GPU picture
         is bound through ISwapChainPanelNative. Off, every frame threw NotSupportedException and calls
         went audio-only with "Media: sending" and 0 bytes encoded (stand, 2026-10-18). -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <PublishReadyToRun>true</PublishReadyToRun>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
