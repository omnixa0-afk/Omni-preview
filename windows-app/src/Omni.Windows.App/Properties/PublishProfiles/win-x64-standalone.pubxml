<?xml version="1.0" encoding="utf-8"?>
<!--
  Standalone single-file build: ONE self-contained .exe that runs on a clean Windows 10/11 x64 PC
  with NO installs (no .NET runtime, no Windows App SDK runtime, no VC++ redist).

  Why this works:
   - SelfContained + WindowsAppSDKSelfContained bundle the .NET runtime AND the WinAppSDK runtime.
   - PublishSingleFile + IncludeNativeLibrariesForSelfExtract pack everything (incl. coreclr and the
     native omni_ffi.dll / omni_webrtc_media.dll) into the single exe; they self-extract to
     %TEMP%\.net\Omni.Windows.App\<hash>\ on first launch.
   - Both native DLLs are statically CRT-linked (Rust +crt-static, CMake /MT), so NO vcruntime140 /
     msvcp140 — nothing from the VC++ redistributable is needed.
   - The rendezvous + Mainline-DHT couriers still run as separate CHILD PROCESSES here, with nothing
     unpacked: this exe re-execs ITSELF with the run-helper flag and Core/HelperMode routes that into
     the courier code linked into omni_ffi.dll. Nothing profile-specific is needed for it — the exe
     with no siblings simply takes the self-exec path (see Core/HelperMode.cs).
   - Trimming stays OFF (WinUI 3 + COM interop + reflection are not trim-safe).

  Build:  dotnet publish windows-app/src/Omni.Windows.App/Omni.Windows.App.csproj -p:PublishProfile=win-x64-standalone
  Ship:   the single Omni.Windows.App.exe from PublishDir. (The .pdb is not produced; nothing else needed.)
  Note:   first launch self-extracts (a few seconds); later launches reuse the extracted folder.
          Each BUILD extracts to its own folder and .NET never removes the old ones (163 of them,
          11 GB, on 2026-10-10): the app removes copies no instance runs from on every start
          (Core/BundleExtractionCleanup.cs).
          The app is portable: it writes its profile db + settings into an OmniData\ folder next to
          the exe (one folder, not a dozen loose files) — copy the pair to move the install.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\x64\publish-standalone\</PublishDir>

    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
