<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="Omni.Windows.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:onboarding="using:Omni.Windows.App.Features.Onboarding"
  xmlns:chats="using:Omni.Windows.App.Features.Chats"
  xmlns:contacts="using:Omni.Windows.App.Features.Contacts"
  xmlns:settings="using:Omni.Windows.App.Features.Settings"
  xmlns:diagnostics="using:Omni.Windows.App.Features.Diagnostics"
  xmlns:workspaces="using:Omni.Windows.App.Features.Workspaces"
  xmlns:calls="using:Omni.Windows.App.Features.Calls"
  xmlns:shared="using:Omni.Windows.App.Features.Shared"
  mc:Ignorable="d">
  <Grid Background="{ThemeResource OmniBgAppBrush}">
    <!-- A ComboBox's list and the InfoBars in the app's colours: their templates read these Fluent keys
         themselves, and an override takes on an element above them, not in App.xaml (see the popup
         styles there). An InfoBar is a soft tint of its state's colour, not Fluent's olive and wine
         (owner, 2026-10-30: «не очень приятно выглядит»). -->
    <Grid.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#172232" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#324761" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#1E2F45" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#223349" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#223349" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#2A3F5A" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#2A3F5A" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#14261F" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#2C181C" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="#2A2416" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#1D2A3D" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="#3DB57A" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityIconBackground" Color="#E5484D" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityIconBackground" Color="#E0A33A" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#9AAED7" />
            <SolidColorBrush x:Key="InfoBarBorderBrush" Color="#26334A" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#C2CEDE" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#E7EDF6" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#DCE6F6" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#DCE6F6" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#CDDBF1" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#CDDBF1" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#E6F4EC" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#FBEBEC" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="#FBF2DF" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#E4EAF4" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="#2B9A66" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityIconBackground" Color="#DC3E42" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityIconBackground" Color="#C27F12" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#3D5A8C" />
            <SolidColorBrush x:Key="InfoBarBorderBrush" Color="#D3DCE9" />
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
      </ResourceDictionary>
    </Grid.Resources>
    <Grid
      x:Name="BootRoot"
      Padding="40">
      <StackPanel
        Width="460"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="18">
        <ProgressRing
          x:Name="BootRing"
          Width="56"
          Height="56"
          HorizontalAlignment="Center"
          IsActive="True" />
        <TextBlock
          HorizontalAlignment="Center"
          FontSize="32"
          FontWeight="SemiBold"
          Text="Omni" />
        <TextBlock
          HorizontalAlignment="Center"
          FontSize="16"
          Opacity="0.76"
          Text="Подготавливаем приложение" />
        <TextBlock
          x:Name="BootStatusTextBlock"
          Text="Инициализируем локальное ядро и проверяем профиль..."
          TextAlignment="Center"
          TextWrapping="WrapWholeWords" />
      </StackPanel>
    </Grid>

    <onboarding:OnboardingShellControl x:Name="OnboardingSectionHost" />

    <Grid
      x:Name="AuthenticatedRoot"
      Visibility="Collapsed">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
        <!-- A call that goes on while its screen is folded away (or another chat is open): one
             strip over everything — tap to go back, or mute / hang up right here. -->
        <Grid
          x:Name="ActiveCallBar"
          Height="40"
          Background="{ThemeResource OmniCallAcceptBrush}"
          Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button
            x:Name="ActiveCallBarReturnButton"
            MinWidth="0"
            MinHeight="0"
            Padding="16,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            AutomationProperties.Name="Вернуться к звонку"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="0"
            Foreground="White">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon VerticalAlignment="Center" FontSize="13" Glyph="&#xE717;" />
              <TextBlock x:Name="ActiveCallBarTextBlock" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
              <TextBlock VerticalAlignment="Center" FontSize="13" Opacity="0.85" Text="Вернуться к звонку" />
            </StackPanel>
          </Button>
          <StackPanel
            Grid.Column="1"
            Margin="0,0,10,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="6">
            <Button
              x:Name="ActiveCallBarMuteButton"
              Width="30"
              Height="30"
              MinWidth="0"
              MinHeight="0"
              Padding="0"
              AutomationProperties.Name="Выключить микрофон"
              Background="#33FFFFFF"
              BorderThickness="0"
              CornerRadius="15"
              Foreground="White">
              <FontIcon x:Name="ActiveCallBarMuteIcon" FontSize="13" Glyph="&#xE720;" />
            </Button>
            <Button
              x:Name="ActiveCallBarHangUpButton"
              Width="30"
              Height="30"
              MinWidth="0"
              MinHeight="0"
              Padding="0"
              AutomationProperties.Name="Завершить звонок"
              Background="{ThemeResource OmniCallHangUpBrush}"
              BorderThickness="0"
              CornerRadius="15"
              Foreground="White">
              <FontIcon FontSize="13" Glyph="&#xE778;" />
            </Button>
          </StackPanel>
        </Grid>
        <Border
          x:Name="IncomingCallBannerBorder"
          Margin="16,12,16,0"
          Padding="14,12"
          Background="{ThemeResource OmniBgElevatedBrush}"
          BorderBrush="{ThemeResource OmniAccentBrush}"
          BorderThickness="1"
          CornerRadius="14"
          Visibility="Collapsed">
          <Grid
            ColumnSpacing="14"
            RowSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
              Width="40"
              Height="40"
              VerticalAlignment="Center"
              Background="{ThemeResource OmniAccentBrush}"
              CornerRadius="20">
              <FontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{ThemeResource OmniBgAppBrush}"
                Glyph="&#xE717;" />
            </Border>
            <StackPanel
              Grid.Column="1"
              VerticalAlignment="Center"
              Spacing="4">
              <TextBlock
                x:Name="IncomingCallBannerTitleTextBlock"
                FontSize="15"
                FontWeight="SemiBold"
                Text="Входящий звонок" />
              <TextBlock
                x:Name="IncomingCallBannerSubtitleTextBlock"
                FontSize="12"
                Opacity="0.84"
                Text="Когда появится входящий звонок, здесь можно будет быстро ответить."
                TextWrapping="WrapWholeWords" />
            </StackPanel>
            <StackPanel
              Grid.Column="2"
              Orientation="Horizontal"
              VerticalAlignment="Center"
              Spacing="10">
              <Button
                x:Name="AcceptIncomingCallButton"
                Content="Принять"
                Style="{StaticResource AccentPrimaryButtonStyle}" />
              <Button
                x:Name="AcceptIncomingCallMutedButton"
                Content="Без микрофона"
                ToolTipService.ToolTip="Ответить с выключенным микрофоном — включите, когда будете готовы" />
              <Button
                x:Name="DeclineIncomingCallButton"
                Content="Отклонить" />
            </StackPanel>
          </Grid>
        </Border>
        </StackPanel>
        <Grid
          x:Name="AuthenticatedShellGrid"
          Grid.Row="1">
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroup>
            <VisualState x:Name="AuthenticatedShellNarrow">
              <VisualState.Setters>
                <Setter Target="AuthenticatedContentHost.Padding" Value="0" />
              </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="AuthenticatedShellMedium">
              <VisualState.StateTriggers>
                <AdaptiveTrigger MinWindowWidth="900" />
              </VisualState.StateTriggers>
              <VisualState.Setters>
                <Setter Target="AuthenticatedContentHost.Padding" Value="0" />
              </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="AuthenticatedShellWide">
              <VisualState.StateTriggers>
                <AdaptiveTrigger MinWindowWidth="1280" />
              </VisualState.StateTriggers>
              <VisualState.Setters>
                <Setter Target="AuthenticatedContentHost.Padding" Value="0" />
              </VisualState.Setters>
            </VisualState>
          </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The sections' rail: each icon with its name under it, always (docs/decisions/omni-app-ux.md §2;
             a bare icon told a newcomer nothing). Its own control, not a NavigationView: that one names
             its items only in the open drawer. -->
        <shared:ShellRail
          x:Name="AuthenticatedNavigationView"
          Grid.Column="0"
          Width="72">
          <shared:ShellRail.Resources>
            <ResourceDictionary>
              <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                  <SolidColorBrush x:Key="OmniRailBackgroundBrush" Color="#0F1924" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                  <SolidColorBrush x:Key="OmniRailBackgroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
              </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
          </shared:ShellRail.Resources>
          <Border
            Background="{ThemeResource OmniRailBackgroundBrush}"
            BorderBrush="{ThemeResource OmniStrokeBrush}"
            BorderThickness="0,0,1,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Padding="0,6,0,0">
                <shared:ShellRailItem
                  x:Name="ChatsNavigationItem"
                  AutomationProperties.AutomationId="ChatsNavigationItem"
                  Label="Чаты"
                  Tag="Chats">
                  <shared:ShellRailItem.Icon>
                    <SymbolIcon Symbol="Message" />
                  </shared:ShellRailItem.Icon>
                </shared:ShellRailItem>
                <!-- Groups with projects (docs/decisions/omni-workspace-ux.md): right under the chats
                     (owner, 2026-10-30). A briefcase, not `{}`: the work is CAD and documents too. -->
                <shared:ShellRailItem
                  x:Name="WorkspacesNavigationItem"
                  AutomationProperties.AutomationId="WorkspacesNavigationItem"
                  Label="Workspaces"
                  Tag="Workspaces">
                  <shared:ShellRailItem.Icon>
                    <FontIcon Glyph="&#xE821;" />
                  </shared:ShellRailItem.Icon>
                </shared:ShellRailItem>
                <shared:ShellRailItem
                  x:Name="ContactsNavigationItem"
                  AutomationProperties.AutomationId="ContactsNavigationItem"
                  Label="Контакты"
                  Tag="Contacts">
                  <shared:ShellRailItem.Icon>
                    <SymbolIcon Symbol="People" />
                  </shared:ShellRailItem.Icon>
                </shared:ShellRailItem>
              </StackPanel>
              <!-- The rare ones at the bottom, then who is signed in. -->
              <StackPanel Grid.Row="1" Padding="0,0,0,8" Spacing="4">
                <shared:ShellRailItem
                  x:Name="SettingsNavigationItem"
                  Label="Настройки"
                  Tag="Settings">
                  <shared:ShellRailItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                  </shared:ShellRailItem.Icon>
                </shared:ShellRailItem>
                <shared:ShellRailItem
                  x:Name="DiagnosticsNavigationItem"
                  Label="Помощь"
                  Tag="Diagnostics">
                  <shared:ShellRailItem.Icon>
                    <FontIcon Glyph="&#xE897;" />
                  </shared:ShellRailItem.Icon>
                </shared:ShellRailItem>
            <Grid
              x:Name="IdentityFooter"
              Margin="0,6,0,0"
              Padding="6"
              Background="{ThemeResource OmniBgElevatedBrush}"
              CornerRadius="10"
              HorizontalAlignment="Center"
              Tapped="OnIdentityFooterTapped"
              AutomationProperties.Name="Профиль">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <shared:AvatarView x:Name="IdentityAvatar" Size="34" OpensPicture="False" />
              <TextBlock
                x:Name="IdentitySubtitleTextBlock"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Профиль не загружен"
                Visibility="Collapsed"
                TextTrimming="CharacterEllipsis" />
            </Grid>
              </StackPanel>
            </Grid>
          </Border>
        </shared:ShellRail>

        <Grid
            x:Name="AuthenticatedContentHost"
            Grid.Column="1"
            Padding="0">
            <chats:ChatsSectionControl x:Name="ChatsSectionHost" />
            <contacts:ContactsSectionControl x:Name="ContactsSectionHost" />
            <workspaces:WorkspacesSectionControl x:Name="WorkspacesSectionHost" />
            <settings:SettingsSectionControl x:Name="SettingsSectionHost" />
            <diagnostics:DiagnosticsSectionControl x:Name="DiagnosticsSectionHost" />
            <!-- A group call rings over whatever section is open (MainWindow.Groups.cs). -->
            <InfoBar
              x:Name="GroupCallRingBar"
              Margin="16,12"
              MaxWidth="560"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Canvas.ZIndex="10"
              IsClosable="True"
              IsOpen="False"
              Severity="Informational">
              <InfoBar.IconSource>
                <FontIconSource Glyph="&#xE717;" />
              </InfoBar.IconSource>
              <InfoBar.Content>
                <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                  <Button x:Name="GroupCallRingJoinButton" Content="Присоединиться" Style="{StaticResource AccentButtonStyle}" />
                  <Button x:Name="GroupCallRingDeclineButton" Content="Отклонить" />
                </StackPanel>
              </InfoBar.Content>
            </InfoBar>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <calls:CallOverlayControl x:Name="CallOverlayHost" />

    <!-- Over everything, the call too: a photo or an avatar on the whole window. -->
    <shared:ImageViewer x:Name="ImageViewerHost" />
  </Grid>
</Window>
