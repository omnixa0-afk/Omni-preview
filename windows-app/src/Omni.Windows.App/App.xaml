<?xml version="1.0" encoding="UTF-8"?>
<Application
  x:Class="Omni.Windows.App.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:calls="using:Omni.Windows.App.Features.Calls"
  xmlns:shared="using:Omni.Windows.App.Features.Shared"
  mc:Ignorable="d">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Omni visual language (see brandbook/contacts-winui-prototype). The accent is a muted
           slate-blue used as a FOREGROUND colour (text, icons, initials) via OmniAccentBrush —
           it is deliberately never a loud fill. "Accent fill" surfaces (Fluent AccentButton,
           avatar circles) are instead quiet dark-slate panels with light text. The SystemAccent
           ramp still drives focus/selection tints; AccentFillColor* are pinned per theme (the
           override takes for these keys — that is how the old brand blue used to be pinned). -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemAccentColor">#9AAED7</Color>
          <Color x:Key="SystemAccentColorLight1">#ADBEE1</Color>
          <Color x:Key="SystemAccentColorLight2">#C0CDE9</Color>
          <Color x:Key="SystemAccentColorLight3">#D3DCF0</Color>
          <Color x:Key="SystemAccentColorDark1">#8399C6</Color>
          <Color x:Key="SystemAccentColorDark2">#6E85B5</Color>
          <Color x:Key="SystemAccentColorDark3">#5A719E</Color>

          <!-- Accent-fill = quiet dark-slate panel + light text (rest/hover/pressed). Avatars
               reuse AccentFillColorSecondary, so they read as dark circles with light initials. -->
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#223349" />
          <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2A3F5A" />
          <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#1B2A3D" />
          <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#EAF0FA" />
          <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#A9B7CC" />

          <!-- Surface ramp (dark). App = deepest window, Panel = section surface, Elevated =
               nested block / input / incoming bubble. Stroke = hairline, SubtleStroke = a touch
               brighter for focal outlines (avatars, active chips). -->
          <SolidColorBrush x:Key="OmniBgAppBrush" Color="#0A111A" />
          <SolidColorBrush x:Key="OmniBgPanelBrush" Color="#0F1924" />
          <SolidColorBrush x:Key="OmniBgElevatedBrush" Color="#172232" />
          <SolidColorBrush x:Key="OmniStrokeBrush" Color="#213047" />
          <SolidColorBrush x:Key="OmniSubtleStrokeBrush" Color="#324761" />

          <!-- Foreground accent + text ramp. -->
          <SolidColorBrush x:Key="OmniAccentBrush" Color="#9AAED7" />
          <SolidColorBrush x:Key="OmniAccentSoftBrush" Color="#1D2A3D" />
          <SolidColorBrush x:Key="OmniTextBrush" Color="#F7FAFF" />
          <SolidColorBrush x:Key="OmniMutedTextBrush" Color="#B4BFCC" />

          <!-- Chat bubbles: bordered, small radius; outgoing = muted navy (never the loud accent). -->
          <SolidColorBrush x:Key="OmniIncomingBubbleBrush" Color="#0F1823" />
          <SolidColorBrush x:Key="OmniOutgoingBubbleBrush" Color="#1D324F" />
          <SolidColorBrush x:Key="OmniBubbleStrokeBrush" Color="#263A54" />

          <!-- List row interaction (hover / selected): consumed as {ThemeResource} colors by the
               per-ListView ListViewItemBackground* overrides (overriding those keys at app level
               doesn't take — Fluent's own merged theme dictionary wins). -->
          <Color x:Key="OmniListHoverColor">#16202E</Color>
          <Color x:Key="OmniListSelectedColor">#17263A</Color>
          <Color x:Key="OmniListSelectedHoverColor">#1E2F45</Color>
          <!-- Every list's hover / selected rows (the chat and contact lists said it each). -->
          <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{StaticResource OmniListHoverColor}" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource OmniListSelectedColor}" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{StaticResource OmniListSelectedHoverColor}" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{StaticResource OmniListSelectedColor}" />

          <!-- Call screens (1:1 and group) follow the theme too. Scrim = the stage colour fading
               over a picture, so text and buttons stay readable on video. -->
          <SolidColorBrush x:Key="OmniCallStageBrush" Color="#0B121C" />
          <SolidColorBrush x:Key="OmniCallTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OmniCallControlBrush" Color="#24FFFFFF" />
          <SolidColorBrush x:Key="OmniCallControlOnBrush" Color="#F2F5FA" />
          <SolidColorBrush x:Key="OmniCallControlOnIconBrush" Color="#0B121C" />
          <SolidColorBrush x:Key="OmniCallControlWarnBrush" Color="#4DE5484D" />
          <SolidColorBrush x:Key="OmniCallControlWarnIconBrush" Color="#FF9A9D" />
          <SolidColorBrush x:Key="OmniCallTileBrush" Color="#18222F" />
          <Color x:Key="OmniCallScrimColor">#CC000000</Color>
          <Color x:Key="OmniCallScrimClearColor">#00000000</Color>

          <!-- Popups: the surface a menu, a drop-down or a dialog stands on. -->
          <SolidColorBrush x:Key="OmniPopupBrush" Color="#172232" />
          <SolidColorBrush x:Key="OmniPopupStrokeBrush" Color="#324761" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="SystemAccentColor">#4C6091</Color>
          <Color x:Key="SystemAccentColorLight1">#5B6FA0</Color>
          <Color x:Key="SystemAccentColorLight2">#6E82B2</Color>
          <Color x:Key="SystemAccentColorLight3">#8598C6</Color>
          <Color x:Key="SystemAccentColorDark1">#41537F</Color>
          <Color x:Key="SystemAccentColorDark2">#37456A</Color>
          <Color x:Key="SystemAccentColorDark3">#2C3856</Color>

          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4C6091" />
          <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#5A6EA0" />
          <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#415380" />
          <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E4EAF4" />

          <!-- Surface ramp (light): cool-tinted, not pure white/grey. -->
          <SolidColorBrush x:Key="OmniBgAppBrush" Color="#EEF2F8" />
          <SolidColorBrush x:Key="OmniBgPanelBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OmniBgElevatedBrush" Color="#E7EDF6" />
          <SolidColorBrush x:Key="OmniStrokeBrush" Color="#D5DEEA" />
          <SolidColorBrush x:Key="OmniSubtleStrokeBrush" Color="#C2CEDE" />

          <SolidColorBrush x:Key="OmniAccentBrush" Color="#4C6091" />
          <SolidColorBrush x:Key="OmniAccentSoftBrush" Color="#E4EAF4" />
          <SolidColorBrush x:Key="OmniTextBrush" Color="#101725" />
          <SolidColorBrush x:Key="OmniMutedTextBrush" Color="#55617A" />

          <SolidColorBrush x:Key="OmniIncomingBubbleBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OmniOutgoingBubbleBrush" Color="#DCE6F6" />
          <SolidColorBrush x:Key="OmniBubbleStrokeBrush" Color="#C9D6E9" />

          <Color x:Key="OmniListHoverColor">#E7EDF6</Color>
          <Color x:Key="OmniListSelectedColor">#DCE6F6</Color>
          <Color x:Key="OmniListSelectedHoverColor">#CDDBF1</Color>
          <!-- Every list's hover / selected rows (the chat and contact lists said it each). -->
          <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{StaticResource OmniListHoverColor}" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource OmniListSelectedColor}" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{StaticResource OmniListSelectedHoverColor}" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{StaticResource OmniListSelectedColor}" />

          <SolidColorBrush x:Key="OmniCallStageBrush" Color="#EEF2F8" />
          <SolidColorBrush x:Key="OmniCallTextBrush" Color="#101725" />
          <SolidColorBrush x:Key="OmniCallControlBrush" Color="#DCE4EF" />
          <SolidColorBrush x:Key="OmniCallControlOnBrush" Color="#1D2A3D" />
          <SolidColorBrush x:Key="OmniCallControlOnIconBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OmniCallControlWarnBrush" Color="#FBDADB" />
          <SolidColorBrush x:Key="OmniCallControlWarnIconBrush" Color="#C42B31" />
          <SolidColorBrush x:Key="OmniCallTileBrush" Color="#DCE4EF" />
          <Color x:Key="OmniCallScrimColor">#E6EEF2F8</Color>
          <Color x:Key="OmniCallScrimClearColor">#00EEF2F8</Color>

          <SolidColorBrush x:Key="OmniPopupBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OmniPopupStrokeBrush" Color="#C2CEDE" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Corner-radius scale. Tightened toward the prototype (controls 8 · cards 12 · pill 999).
           Overriding the Fluent defaults aligns text boxes/combos/lists with the app's buttons. -->
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

      <!-- Menus, flyouts and dialogs in the app's colours (owner, 2026-10-11 and again 2026-10-30:
           «выпадающие меню не состыковываются с темой»). Overriding Fluent's own keys here does not
           take — the Fluent templates find those keys in XamlControlsResources first — so the styles
           set the surfaces to Omni's keys; and a menu is painted by a system acrylic backdrop with a
           transparent background on top, so the backdrop goes. The drop-down list of a ComboBox
           takes its keys on the window's root (MainWindow.xaml). -->
      <Style TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
        <Setter Property="SystemBackdrop" Value="{x:Null}" />
        <Setter Property="Background" Value="{ThemeResource OmniPopupBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniPopupStrokeBrush}" />
      </Style>
      <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
        <Setter Property="Background" Value="{ThemeResource OmniPopupBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniPopupStrokeBrush}" />
      </Style>
      <!-- The buttons' strip at the bottom is the dialog's background; Fluent lays a faint layer over
           the top part, so the content reads a shade lighter than the buttons, as before. -->
      <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="Background" Value="{ThemeResource OmniBgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniPopupStrokeBrush}" />
      </Style>
      <!-- CheckBox with a font check mark (docs/bugs/checkbox-glyph-windows10.md). Fluent draws the
           mark with an AnimatedIcon whose fallback font glyph stays on and is hidden only by its
           colour; on Windows 10 the box showed a circle with a dash, in the dark theme also when
           unchecked (our TextOnAccentFillColorPrimaryBrush is light there). Here the mark is a
           FontIcon of the system symbol font (Segoe Fluent Icons on 11, Segoe MDL2 Assets on 10 —
           E73E and E738 are in both) shown by opacity. Colours and states are Fluent's own. -->
      <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid
                x:Name="RootGrid"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CombinedStates">
                    <VisualState x:Name="UncheckedNormal" />
                    <VisualState x:Name="UncheckedPointerOver">
                      <VisualState.Setters>
                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource CheckBoxForegroundUncheckedPointerOver}" />
                        <Setter Target="RootGrid.Background" Value="{ThemeResource CheckBoxBackgroundUncheckedPointerOver}" />
                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CheckBoxBorderBrushUncheckedPointerOver}" />
                        <Setter Target="NormalRectangle.Stroke" Value="{ThemeResource CheckBoxCheckBackgroundStrokeUncheckedPointerOver}" />
                        <Setter Target="NormalRectangle.Fill" Value="{ThemeResource CheckBoxCheckBackgroundFillUncheckedPointerOver}" />
                        <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource CheckBoxCheckGlyphForegroundUncheckedPointerOver}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="UncheckedPressed">
                      <VisualState.Setters>
                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource CheckBoxForegroundUncheckedPressed}" />
                        <Setter Target="RootGrid.Background" Value="{ThemeResource CheckBoxBackgroundUncheckedPressed}" />
                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CheckBoxBorderBrushUncheckedPressed}" />
                        <Setter Target="NormalRectangle.Stroke" Value="{ThemeResource CheckBoxCheckBackgroundStrokeUncheckedPressed}" />
                        <Setter Target="NormalRectangle.Fill" Value="{ThemeResource CheckBoxCheckBackgroundFillUncheckedPressed}" />
                        <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource CheckBoxCheckGlyphForegroundUncheckedPressed}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="UncheckedDisabled">
                      <VisualState.Setters>
                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource CheckBoxForegroundUncheckedDisabled}" />
                        <Setter Target="RootGrid.Background" Value="{ThemeResource CheckBoxBackgroundUncheckedDisabled}" />
                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CheckBoxBorderBrushUncheckedDisabled}" />
                        <Setter Target="NormalRectangle.Stroke" Value="{ThemeResource CheckBoxCheckBackgroundStrokeUncheckedDisabled}" />
                        <Setter Target="NormalRectangle.Fill" Value="{ThemeResource CheckBoxCheckBackgroundFillUncheckedDisabled}" />
                        <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource CheckBoxCheckGlyphForegroundUncheckedDisabled}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedNormal">
                      <VisualState.Setters>
                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource CheckBoxForegroundChecked}" />
                        <Setter Target="RootGrid.Background" Value="{ThemeResource CheckBoxBackgroundChecked}" />
                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CheckBoxBorderBrushChecked}" />
                        <Setter Target="NormalRectangle.Stroke" Value="{ThemeResource CheckBoxCheckBackgroundStrokeChecked}" />
                        <Setter Target="NormalRectangle.Fill" Value="{ThemeResource CheckBoxCheckBackgroundFillChecked}" />
                        <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource CheckBoxCheckGlyphForegroundChecked}" />
                        <Setter Target="CheckGlyph.Opacity" Value="1" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPointerOver">
                      <VisualState.Setters>
                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource CheckBoxForegroundCheckedPointerOver}" />
                        <Setter Target="RootGrid.Background" Value="{ThemeResource CheckBoxBackgroundCheckedPointerOver}" />
                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CheckBoxBorderBrushCheckedPointerOver}" />
                        <Setter Target="NormalRectangle.Stroke" Value="{ThemeResource CheckBoxCheckBackgroundStrokeCheckedPointerOver}" />
                        <Setter Target="NormalRectangle.Fill" Value="{ThemeResource CheckBoxCheckBackgroundFillCheckedPointerOver}" />
                        <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource CheckBoxCheckGlyphForegroundCheckedPointerOver}" />
                        <Setter Target="CheckGlyph.Opacity" Value="1" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPressed">
                      <VisualState.Setters>
                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource CheckBoxForegroundCheckedPressed}" />
                        <Setter Target="RootGrid.Background" Value="{ThemeResource CheckBoxBackgroundCheckedPressed}" />
                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CheckBoxBorderBrushCheckedPressed}" />
                        <Setter Target="NormalRectangle.Stroke" Value="{ThemeResource CheckBoxCheckBackgroundStrokeCheckedPressed}" />
                        <Setter Target="NormalRectangle.Fill" Value="{ThemeResource CheckBoxCheckBackgroundFillCheckedPressed}" />
                        <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource CheckBoxCheckGlyphForegroundCheckedPressed}" />
                        <Setter Target="CheckGlyph.Opacity" Value="1" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedDisabled">
                      <VisualState.Setters>
                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource CheckBoxForegroundCheckedDisabled}" />
                        <Setter Target="RootGrid.Background" Value="{ThemeResource CheckBoxBackgroundCheckedDisabled}" />
                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CheckBoxBorderBrushCheckedDisabled}" />
                        <Setter Target="NormalRectangle.Stroke" Value="{ThemeResource CheckBoxCheckBackgroundStrokeCheckedDisabled}" />
                        <Setter Target="NormalRectangle.Fill" Value="{ThemeResource CheckBoxCheckBackgroundFillCheckedDisabled}" />
                        <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource CheckBoxCheckGlyphForegroundCheckedDisabled}" />
                        <Setter Target="CheckGlyph.Opacity" Value="1" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="IndeterminateNormal">
                      <VisualState.Setters>
                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource CheckBoxForegroundIndeterminate}" />
                        <Setter Target="RootGrid.Background" Value="{ThemeResource CheckBoxBackgroundIndeterminate}" />
                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CheckBoxBorderBrushIndeterminate}" />
                        <Setter Target="NormalRectangle.Stroke" Value="{ThemeResource CheckBoxCheckBackgroundStrokeIndeterminate}" />
                        <Setter Target="NormalRectangle.Fill" Value="{ThemeResource CheckBoxCheckBackgroundFillIndeterminate}" />
                        <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource CheckBoxCheckGlyphForegroundIndeterminate}" />
                        <Setter Target="CheckGlyph.Opacity" Value="1" />
                        <Setter Target="CheckGlyph.Glyph" Value="&#xE738;" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="IndeterminatePointerOver">
                      <VisualState.Setters>
                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource CheckBoxForegroundIndeterminatePointerOver}" />
                        <Setter Target="RootGrid.Background" Value="{ThemeResource CheckBoxBackgroundIndeterminatePointerOver}" />
                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CheckBoxBorderBrushIndeterminatePointerOver}" />
                        <Setter Target="NormalRectangle.Stroke" Value="{ThemeResource CheckBoxCheckBackgroundStrokeIndeterminatePointerOver}" />
                        <Setter Target="NormalRectangle.Fill" Value="{ThemeResource CheckBoxCheckBackgroundFillIndeterminatePointerOver}" />
                        <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource CheckBoxCheckGlyphForegroundIndeterminatePointerOver}" />
                        <Setter Target="CheckGlyph.Opacity" Value="1" />
                        <Setter Target="CheckGlyph.Glyph" Value="&#xE738;" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="IndeterminatePressed">
                      <VisualState.Setters>
                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource CheckBoxForegroundIndeterminatePressed}" />
                        <Setter Target="RootGrid.Background" Value="{ThemeResource CheckBoxBackgroundIndeterminatePressed}" />
                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CheckBoxBorderBrushIndeterminatePressed}" />
                        <Setter Target="NormalRectangle.Stroke" Value="{ThemeResource CheckBoxCheckBackgroundStrokeIndeterminatePressed}" />
                        <Setter Target="NormalRectangle.Fill" Value="{ThemeResource CheckBoxCheckBackgroundFillIndeterminatePressed}" />
                        <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource CheckBoxCheckGlyphForegroundIndeterminatePressed}" />
                        <Setter Target="CheckGlyph.Opacity" Value="1" />
                        <Setter Target="CheckGlyph.Glyph" Value="&#xE738;" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="IndeterminateDisabled">
                      <VisualState.Setters>
                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource CheckBoxForegroundIndeterminateDisabled}" />
                        <Setter Target="RootGrid.Background" Value="{ThemeResource CheckBoxBackgroundIndeterminateDisabled}" />
                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CheckBoxBorderBrushIndeterminateDisabled}" />
                        <Setter Target="NormalRectangle.Stroke" Value="{ThemeResource CheckBoxCheckBackgroundStrokeIndeterminateDisabled}" />
                        <Setter Target="NormalRectangle.Fill" Value="{ThemeResource CheckBoxCheckBackgroundFillIndeterminateDisabled}" />
                        <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource CheckBoxCheckGlyphForegroundIndeterminateDisabled}" />
                        <Setter Target="CheckGlyph.Opacity" Value="1" />
                        <Setter Target="CheckGlyph.Glyph" Value="&#xE738;" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="{StaticResource CheckBoxSize}" Height="{StaticResource CheckBoxSize}" VerticalAlignment="Center">
                  <Rectangle
                    x:Name="NormalRectangle"
                    Width="{StaticResource CheckBoxSize}"
                    Height="{StaticResource CheckBoxSize}"
                    Fill="{ThemeResource CheckBoxCheckBackgroundFillUnchecked}"
                    RadiusX="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TopLeftCornerRadiusDoubleValueConverter}}"
                    RadiusY="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BottomRightCornerRadiusDoubleValueConverter}}"
                    Stroke="{ThemeResource CheckBoxCheckBackgroundStrokeUnchecked}"
                    StrokeThickness="{StaticResource CheckBoxBorderThickness}"
                    UseLayoutRounding="False" />
                  <FontIcon
                    x:Name="CheckGlyph"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="{StaticResource CheckBoxGlyphSize}"
                    Foreground="{ThemeResource CheckBoxCheckGlyphForegroundUnchecked}"
                    Glyph="&#xE73E;"
                    Opacity="0" />
                </Grid>
                <ContentPresenter
                  x:Name="ContentPresenter"
                  Grid.Column="1"
                  Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  AutomationProperties.AccessibilityView="Raw"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  ContentTransitions="{TemplateBinding ContentTransitions}"
                  Foreground="{TemplateBinding Foreground}"
                  TextWrapping="Wrap" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="Button">
        <Setter Property="MinWidth" Value="108" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>

      <!-- The one button beside a list's title («+ Группа», «+ Добавить», «+ Workspace»): one width,
           so its left edge does not jump between the sections (owner, 2026-10-30). -->
      <Style x:Key="PaneHeaderButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>

      <!-- The accent button of a sentence or a card («Сохранить версию», «Беру в работу»): the plain
           button's geometry with the accent fill, so the two stand the same height side by side. -->
      <Style x:Key="AccentActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="108" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>

      <!-- Primary action: quiet dark-slate accent fill + light text (see accent notes above). -->
      <Style x:Key="AccentPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="176" />
        <Setter Property="Padding" Value="16,9" />
      </Style>

      <Style x:Key="CompactIconButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>

      <!-- Icon-only button without chrome (headers, inline row actions). -->
      <Style x:Key="GhostIconButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactIconButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>

      <!-- One row for the chat list and the contact list (owner, 2026-10-11: the rows and their
           heights jumped between «Чаты» and «Контакты»): the avatar, the name (a group with the
           "people" mark) and the time on one line, the preview or the status under it, a corner
           word. Bound by name: ChatThreadListItem and ContactListItem both have these. -->
      <Style x:Key="PersonListViewStyle" TargetType="ListView">
        <Setter Property="SelectionMode" Value="Single" />
        <!-- The item draws its hover/selection plate 4 px inside its edges; the list steps out by
             as much, so the plate lines up with the search box and the header button above. -->
        <Setter Property="Margin" Value="-4,0,-4,0" />
      </Style>
      <!-- The hover/selection plate is the row's own rounded border (owner, 2026-11-01: the
           presenter's plate stayed square whatever CornerRadius said), 4 px inside the row's
           edges, in the list colours of the theme. -->
      <Style x:Key="PersonListItemStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="4,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListViewItem">
              <!-- The row's content keeps the whole width, as under the presenter before. -->
              <Grid>
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="Plate.Background" Value="{ThemeResource ListViewItemBackgroundPointerOver}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters>
                        <Setter Target="Plate.Background" Value="{ThemeResource ListViewItemBackgroundPointerOver}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                      <VisualState.Setters>
                        <Setter Target="Plate.Background" Value="{ThemeResource ListViewItemBackgroundSelected}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOverSelected">
                      <VisualState.Setters>
                        <Setter Target="Plate.Background" Value="{ThemeResource ListViewItemBackgroundSelectedPointerOver}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PressedSelected">
                      <VisualState.Setters>
                        <Setter Target="Plate.Background" Value="{ThemeResource ListViewItemBackgroundSelectedPressed}" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border
                  x:Name="Plate"
                  Margin="4,0"
                  Background="Transparent"
                  CornerRadius="8" />
                <ContentPresenter
                  Padding="{TemplateBinding Padding}"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  ContentTransitions="{TemplateBinding ContentTransitions}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="PersonRowTemplate">
        <Border
          Padding="12,8"
          Background="Transparent"
          CornerRadius="8">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
              Width="46"
              Height="46"
              VerticalAlignment="Center">
              <shared:AvatarView
                Fill="{Binding AvatarBrush}"
                LoadingVisibility="{Binding AvatarLoadingVisibility}"
                Picture="{Binding AvatarImage}"
                PictureTitle="{Binding Title}"
                Size="46"
                Text="{Binding AvatarText}" />
              <!-- A group's mark sits where a person's presence dot does (a group has no presence),
                   so the names of groups and people start in one column (owner, 2026-10-11:
                   «сделай тут равнее» — the mark before the name pushed group names right). -->
              <Border
                Width="18"
                Height="18"
                Margin="0,0,-3,-3"
                CornerRadius="9"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{ThemeResource OmniBgPanelBrush}"
                Visibility="{Binding GroupMarkVisibility}">
                <FontIcon FontSize="11" Glyph="{Binding GroupMarkGlyph}" />
              </Border>
              <Border
                Width="14"
                Height="14"
                CornerRadius="7"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{ThemeResource OmniBgPanelBrush}"
                Visibility="{Binding PresenceDotVisibility}">
                <Ellipse
                  Width="10"
                  Height="10"
                  Fill="{Binding PresenceDotBrush}" />
              </Border>
            </Grid>
            <Grid
              Grid.Column="1"
              VerticalAlignment="Center"
              ColumnSpacing="8"
              RowSpacing="3">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                MaxLines="1"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis" />
              <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="11"
                Opacity="0.65"
                Text="{Binding TimeText}" />
              <TextBlock
                Grid.Row="1"
                FontSize="12.5"
                MaxLines="1"
                Opacity="0.75"
                Text="{Binding PreviewText}"
                TextTrimming="CharacterEllipsis" />
              <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
                <TextBlock
                  VerticalAlignment="Center"
                  FontSize="11"
                  Foreground="{ThemeResource OmniAccentBrush}"
                  MaxLines="1"
                  Text="{Binding CornerText}" />
                <!-- Unread lines of the chat (a contact row has none: collapsed). -->
                <Border
                  MinWidth="20"
                  Height="20"
                  Padding="6,0"
                  CornerRadius="10"
                  Background="{ThemeResource AccentFillColorDefaultBrush}"
                  Visibility="{Binding UnreadBadgeVisibility}">
                  <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Text="{Binding UnreadBadgeText}" />
                </Border>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- An action tile on a group's or a contact's page (icon over a caption: Звонок, Пригласить,
           Ещё…), as in Telegram. -->
      <Style x:Key="ActionTileButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Padding" Value="4,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource OmniBgElevatedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
      </Style>

      <!-- Round icon button with a hairline outline + accent glyph (chat send, call answer). -->
      <Style x:Key="AccentCircleIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniSubtleStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource OmniAccentBrush}" />
      </Style>

      <!-- Destructive actions (delete profile, wipe local data): quiet until hovered, but
           clearly marked as dangerous. -->
      <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="108" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
      </Style>

      <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="999" />
      </Style>

      <Style x:Key="AccentPillButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="999" />
      </Style>

      <Style x:Key="ContactFilterButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="4,5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Opacity" Value="0.72" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="ContactFilterAccentButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="4,5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OmniAccentBrush}" />
      </Style>

      <!-- Card surfaces follow the Omni ramp: panel card (top-level sections) and elevated
           sub-card (nested blocks). One style each, used across every screen so they read
           identically. -->
      <!-- A section of a settings page: its title, its content, a hairline under it — no box (owner,
           2026-10-12: «отказаться от таких пузыриков» everywhere in the settings). -->
      <!-- A page title (Settings / Diagnostics): 22, not 26 — the page is one section, the big
           title only pushed it down (owner, 2026-10-12: «пустые большие поля»). -->
      <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="0,2,0,16" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
      </Style>

      <!-- A block INSIDE a card: a section under a hairline, not another box (owner, 2026-10-11:
           «пузырики в пузырике … перегружает дизайн»). It was an elevated rounded box with its own
           border, so a card of settings read as boxes in a box in a box. -->
      <Style x:Key="SubtleBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="0,14,0,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
      </Style>

      <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <!-- Calls (1:1 and group) share one stage (themed above) and the same round control bar.
           Hang up / accept are the same red and green in both themes. -->
      <SolidColorBrush x:Key="OmniCallHangUpBrush" Color="#E5484D" />
      <SolidColorBrush x:Key="OmniCallAcceptBrush" Color="#30A46C" />

      <!-- The control-bar button (CallButton): circle + caption; IsOn = filled circle (camera, screen on);
           IsOn with IsWarning = a red-tinted circle (the microphone is off: the other side does not hear
           you — it must not look like "camera on", owner's night pass 2026-10-13). -->
      <Style TargetType="calls:CallButton">
        <Setter Property="Background" Value="{ThemeResource OmniCallControlBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OmniCallTextBrush}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="calls:CallButton">
              <StackPanel x:Name="Root" Width="76" Background="Transparent" Spacing="7">
                <Grid Width="56" Height="56" HorizontalAlignment="Center">
                  <Ellipse x:Name="Fill" Fill="{TemplateBinding Background}" />
                  <Ellipse x:Name="OnFill" Fill="{ThemeResource OmniCallControlOnBrush}" Opacity="0" />
                  <Ellipse x:Name="WarnFill" Fill="{ThemeResource OmniCallControlWarnBrush}" Opacity="0" />
                  <Ellipse x:Name="Hover" Fill="{ThemeResource OmniCallTextBrush}" Opacity="0" />
                  <ContentPresenter
                    x:Name="Icon"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Content}"
                    Foreground="{TemplateBinding Foreground}" />
                </Grid>
                <TextBlock
                  HorizontalAlignment="Center"
                  FontSize="12"
                  Foreground="{ThemeResource OmniCallTextBrush}"
                  Opacity="0.82"
                  Text="{TemplateBinding Caption}"
                  TextAlignment="Center"
                  TextTrimming="CharacterEllipsis" />
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="Hover.Opacity" Value="0.1" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters>
                        <Setter Target="Hover.Opacity" Value="0.18" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <VisualState.Setters>
                        <Setter Target="Root.Opacity" Value="0.4" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="OnStates">
                    <VisualState x:Name="Off" />
                    <VisualState x:Name="On">
                      <VisualState.Setters>
                        <Setter Target="OnFill.Opacity" Value="1" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource OmniCallControlOnIconBrush}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="OnWarning">
                      <VisualState.Setters>
                        <Setter Target="WarnFill.Opacity" Value="1" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource OmniCallControlWarnIconBrush}" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
              </StackPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Settings and Diagnostics pages (2026-10-13): groups of flat rows — a small group title,
           rows with the name on the left and the control on the right, a hairline under each row
           (Features/Shared/SettingRow.cs). -->
      <Style x:Key="SettingGroupTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,24,0,2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OmniAccentBrush}" />
      </Style>

      <!-- The line under a setting, a status, an explanation: smaller and quieter than the setting. -->
      <Style x:Key="SettingCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Opacity" Value="0.66" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
      </Style>

      <!-- A row built in code (a courier, a relay, a DHT entry node): the same line as SettingRow. -->
      <Style x:Key="SettingListRowStyle" TargetType="Border">
        <Setter Property="Padding" Value="0,11,0,11" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
      </Style>


      <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.72" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
