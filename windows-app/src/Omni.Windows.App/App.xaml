<?xml version="1.0" encoding="UTF-8"?>
<Application
  x:Class="Omni.Windows.App.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:calls="using:Omni.Windows.App.Features.Calls"
  xmlns:shared="using:Omni.Windows.App.Features.Shared"
  mc:Ignorable="d">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Omni visual language (see brandbook/contacts-winui-prototype). The accent is a muted
           slate-blue used as a FOREGROUND colour (text, icons, initials) via OmniAccentBrush —
           it is deliberately never a loud fill. "Accent fill" surfaces (Fluent AccentButton,
           avatar circles) are instead quiet dark-slate panels with light text. The SystemAccent
           ramp still drives focus/selection tints; AccentFillColor* are pinned per theme (the
           override takes for these keys — that is how the old brand blue used to be pinned). -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemAccentColor">#9AAED7</Color>
          <Color x:Key="SystemAccentColorLight1">#ADBEE1</Color>
          <Color x:Key="SystemAccentColorLight2">#C0CDE9</Color>
          <Color x:Key="SystemAccentColorLight3">#D3DCF0</Color>
          <Color x:Key="SystemAccentColorDark1">#8399C6</Color>
          <Color x:Key="SystemAccentColorDark2">#6E85B5</Color>
          <Color x:Key="SystemAccentColorDark3">#5A719E</Color>

          <!-- Accent-fill = quiet dark-slate panel + light text (rest/hover/pressed). Avatars
               reuse AccentFillColorSecondary, so they read as dark circles with light initials. -->
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#223349" />
          <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2A3F5A" />
          <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#1B2A3D" />
          <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#EAF0FA" />
          <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#A9B7CC" />

          <!-- Surface ramp (dark). App = deepest window, Panel = section surface, Elevated =
               nested block / input / incoming bubble. Stroke = hairline, SubtleStroke = a touch
               brighter for focal outlines (avatars, active chips). -->
          <SolidColorBrush x:Key="OmniBgAppBrush" Color="#0A111A" />
          <SolidColorBrush x:Key="OmniBgPanelBrush" Color="#0F1924" />
          <SolidColorBrush x:Key="OmniBgElevatedBrush" Color="#172232" />
          <SolidColorBrush x:Key="OmniStrokeBrush" Color="#213047" />
          <SolidColorBrush x:Key="OmniSubtleStrokeBrush" Color="#324761" />

          <!-- Foreground accent + text ramp. -->
          <SolidColorBrush x:Key="OmniAccentBrush" Color="#9AAED7" />
          <SolidColorBrush x:Key="OmniAccentSoftBrush" Color="#1D2A3D" />
          <SolidColorBrush x:Key="OmniTextBrush" Color="#F7FAFF" />
          <SolidColorBrush x:Key="OmniMutedTextBrush" Color="#B4BFCC" />

          <!-- Chat bubbles: bordered, small radius; outgoing = muted navy (never the loud accent). -->
          <SolidColorBrush x:Key="OmniIncomingBubbleBrush" Color="#0F1823" />
          <SolidColorBrush x:Key="OmniOutgoingBubbleBrush" Color="#1D324F" />
          <SolidColorBrush x:Key="OmniBubbleStrokeBrush" Color="#263A54" />

          <!-- List row interaction (hover / selected): consumed as {ThemeResource} colors by the
               per-ListView ListViewItemBackground* overrides (overriding those keys at app level
               doesn't take — Fluent's own merged theme dictionary wins). -->
          <Color x:Key="OmniListHoverColor">#16202E</Color>
          <Color x:Key="OmniListSelectedColor">#17263A</Color>
          <Color x:Key="OmniListSelectedHoverColor">#1E2F45</Color>
          <!-- Every list's hover / selected rows (the chat and contact lists said it each). -->
          <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{StaticResource OmniListHoverColor}" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource OmniListSelectedColor}" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{StaticResource OmniListSelectedHoverColor}" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{StaticResource OmniListSelectedColor}" />

          <!-- Call screens (1:1 and group) follow the theme too. Scrim = the stage colour fading
               over a picture, so text and buttons stay readable on video. -->
          <SolidColorBrush x:Key="OmniCallStageBrush" Color="#0B121C" />
          <SolidColorBrush x:Key="OmniCallTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OmniCallControlBrush" Color="#24FFFFFF" />
          <SolidColorBrush x:Key="OmniCallControlOnBrush" Color="#F2F5FA" />
          <SolidColorBrush x:Key="OmniCallControlOnIconBrush" Color="#0B121C" />
          <SolidColorBrush x:Key="OmniCallControlWarnBrush" Color="#4DE5484D" />
          <SolidColorBrush x:Key="OmniCallControlWarnIconBrush" Color="#FF9A9D" />
          <SolidColorBrush x:Key="OmniCallTileBrush" Color="#18222F" />
          <Color x:Key="OmniCallScrimColor">#CC000000</Color>
          <Color x:Key="OmniCallScrimClearColor">#00000000</Color>

          <!-- Drop-downs (ComboBox lists, menus) in the app's colours, not Fluent's grey acrylic
               (owner, 2026-10-11: «выпадающие меню не состыковываются с темой»). -->
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#172232" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#324761" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#1E2F45" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#223349" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#223349" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#2A3F5A" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#2A3F5A" />
          <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="#9AAED7" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#172232" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#324761" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#1E2F45" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#223349" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#172232" />
          <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#324761" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="SystemAccentColor">#4C6091</Color>
          <Color x:Key="SystemAccentColorLight1">#5B6FA0</Color>
          <Color x:Key="SystemAccentColorLight2">#6E82B2</Color>
          <Color x:Key="SystemAccentColorLight3">#8598C6</Color>
          <Color x:Key="SystemAccentColorDark1">#41537F</Color>
          <Color x:Key="SystemAccentColorDark2">#37456A</Color>
          <Color x:Key="SystemAccentColorDark3">#2C3856</Color>

          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4C6091" />
          <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#5A6EA0" />
          <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#415380" />
          <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E4EAF4" />

          <!-- Surface ramp (light): cool-tinted, not pure white/grey. -->
          <SolidColorBrush x:Key="OmniBgAppBrush" Color="#EEF2F8" />
          <SolidColorBrush x:Key="OmniBgPanelBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OmniBgElevatedBrush" Color="#E7EDF6" />
          <SolidColorBrush x:Key="OmniStrokeBrush" Color="#D5DEEA" />
          <SolidColorBrush x:Key="OmniSubtleStrokeBrush" Color="#C2CEDE" />

          <SolidColorBrush x:Key="OmniAccentBrush" Color="#4C6091" />
          <SolidColorBrush x:Key="OmniAccentSoftBrush" Color="#E4EAF4" />
          <SolidColorBrush x:Key="OmniTextBrush" Color="#101725" />
          <SolidColorBrush x:Key="OmniMutedTextBrush" Color="#55617A" />

          <SolidColorBrush x:Key="OmniIncomingBubbleBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OmniOutgoingBubbleBrush" Color="#DCE6F6" />
          <SolidColorBrush x:Key="OmniBubbleStrokeBrush" Color="#C9D6E9" />

          <Color x:Key="OmniListHoverColor">#E7EDF6</Color>
          <Color x:Key="OmniListSelectedColor">#DCE6F6</Color>
          <Color x:Key="OmniListSelectedHoverColor">#CDDBF1</Color>
          <!-- Every list's hover / selected rows (the chat and contact lists said it each). -->
          <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{StaticResource OmniListHoverColor}" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource OmniListSelectedColor}" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{StaticResource OmniListSelectedHoverColor}" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{StaticResource OmniListSelectedColor}" />

          <SolidColorBrush x:Key="OmniCallStageBrush" Color="#EEF2F8" />
          <SolidColorBrush x:Key="OmniCallTextBrush" Color="#101725" />
          <SolidColorBrush x:Key="OmniCallControlBrush" Color="#DCE4EF" />
          <SolidColorBrush x:Key="OmniCallControlOnBrush" Color="#1D2A3D" />
          <SolidColorBrush x:Key="OmniCallControlOnIconBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OmniCallControlWarnBrush" Color="#FBDADB" />
          <SolidColorBrush x:Key="OmniCallControlWarnIconBrush" Color="#C42B31" />
          <SolidColorBrush x:Key="OmniCallTileBrush" Color="#DCE4EF" />
          <Color x:Key="OmniCallScrimColor">#E6EEF2F8</Color>
          <Color x:Key="OmniCallScrimClearColor">#00EEF2F8</Color>

          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#C2CEDE" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#E7EDF6" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#DCE6F6" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#DCE6F6" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#CDDBF1" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#CDDBF1" />
          <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="#4C6091" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#C2CEDE" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#E7EDF6" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#DCE6F6" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#C2CEDE" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Corner-radius scale. Tightened toward the prototype (controls 8 · cards 12 · pill 999).
           Overriding the Fluent defaults aligns text boxes/combos/lists with the app's buttons. -->
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

      <Style TargetType="Button">
        <Setter Property="MinWidth" Value="108" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>

      <!-- Primary action: quiet dark-slate accent fill + light text (see accent notes above). -->
      <Style x:Key="AccentPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="176" />
        <Setter Property="Padding" Value="16,9" />
      </Style>

      <Style x:Key="CompactIconButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>

      <!-- Icon-only button without chrome (headers, inline row actions). -->
      <Style x:Key="GhostIconButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactIconButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>

      <!-- One row for the chat list and the contact list (owner, 2026-10-11: the rows and their
           heights jumped between «Чаты» and «Контакты»): the avatar, the name (a group with the
           "people" mark) and the time on one line, the preview or the status under it, a corner
           word. Bound by name: ChatThreadListItem and ContactListItem both have these. -->
      <Style x:Key="PersonListViewStyle" TargetType="ListView">
        <Setter Property="SelectionMode" Value="Single" />
        <!-- The item draws its hover/selection plate 4 px inside its edges; the list steps out by
             as much, so the plate lines up with the search box and the header button above. -->
        <Setter Property="Margin" Value="-4,0,-4,0" />
      </Style>
      <Style x:Key="PersonListItemStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>
      <DataTemplate x:Key="PersonRowTemplate">
        <Border
          Padding="12,8"
          Background="Transparent"
          CornerRadius="8">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
              Width="46"
              Height="46"
              VerticalAlignment="Center">
              <shared:AvatarView
                Fill="{Binding AvatarBrush}"
                LoadingVisibility="{Binding AvatarLoadingVisibility}"
                Picture="{Binding AvatarImage}"
                PictureTitle="{Binding Title}"
                Size="46"
                Text="{Binding AvatarText}" />
              <!-- A group's mark sits where a person's presence dot does (a group has no presence),
                   so the names of groups and people start in one column (owner, 2026-10-11:
                   «сделай тут равнее» — the mark before the name pushed group names right). -->
              <Border
                Width="18"
                Height="18"
                Margin="0,0,-3,-3"
                CornerRadius="9"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{ThemeResource OmniBgPanelBrush}"
                Visibility="{Binding GroupMarkVisibility}">
                <FontIcon FontSize="11" Glyph="&#xE716;" />
              </Border>
              <Border
                Width="14"
                Height="14"
                CornerRadius="7"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{ThemeResource OmniBgPanelBrush}"
                Visibility="{Binding PresenceDotVisibility}">
                <Ellipse
                  Width="10"
                  Height="10"
                  Fill="{Binding PresenceDotBrush}" />
              </Border>
            </Grid>
            <Grid
              Grid.Column="1"
              VerticalAlignment="Center"
              ColumnSpacing="8"
              RowSpacing="3">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                MaxLines="1"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis" />
              <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="11"
                Opacity="0.65"
                Text="{Binding TimeText}" />
              <TextBlock
                Grid.Row="1"
                FontSize="12.5"
                MaxLines="1"
                Opacity="0.75"
                Text="{Binding PreviewText}"
                TextTrimming="CharacterEllipsis" />
              <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
                <TextBlock
                  VerticalAlignment="Center"
                  FontSize="11"
                  Foreground="{ThemeResource OmniAccentBrush}"
                  MaxLines="1"
                  Text="{Binding CornerText}" />
                <!-- Unread lines of the chat (a contact row has none: collapsed). -->
                <Border
                  MinWidth="20"
                  Height="20"
                  Padding="6,0"
                  CornerRadius="10"
                  Background="{ThemeResource AccentFillColorDefaultBrush}"
                  Visibility="{Binding UnreadBadgeVisibility}">
                  <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Text="{Binding UnreadBadgeText}" />
                </Border>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- An action tile on a group's or a contact's page (icon over a caption: Звонок, Пригласить,
           Ещё…), as in Telegram. -->
      <Style x:Key="ActionTileButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Padding" Value="4,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource OmniBgElevatedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
      </Style>

      <!-- Round icon button with a hairline outline + accent glyph (chat send, call answer). -->
      <Style x:Key="AccentCircleIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniSubtleStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource OmniAccentBrush}" />
      </Style>

      <!-- Destructive actions (delete profile, wipe local data): quiet until hovered, but
           clearly marked as dangerous. -->
      <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="108" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
      </Style>

      <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="999" />
      </Style>

      <Style x:Key="AccentPillButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="999" />
      </Style>

      <Style x:Key="ContactFilterButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="4,5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Opacity" Value="0.72" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="ContactFilterAccentButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="4,5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OmniAccentBrush}" />
      </Style>

      <!-- Card surfaces follow the Omni ramp: panel card (top-level sections) and elevated
           sub-card (nested blocks). One style each, used across every screen so they read
           identically. -->
      <!-- A section of a settings page: its title, its content, a hairline under it — no box (owner,
           2026-10-12: «отказаться от таких пузыриков» everywhere in the settings). -->
      <!-- A page title (Settings / Diagnostics): 22, not 26 — the page is one section, the big
           title only pushed it down (owner, 2026-10-12: «пустые большие поля»). -->
      <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="0,2,0,16" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
      </Style>

      <!-- A block INSIDE a card: a section under a hairline, not another box (owner, 2026-10-11:
           «пузырики в пузырике … перегружает дизайн»). It was an elevated rounded box with its own
           border, so a card of settings read as boxes in a box in a box. -->
      <Style x:Key="SubtleBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="0,14,0,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
      </Style>

      <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <!-- Calls (1:1 and group) share one stage (themed above) and the same round control bar.
           Hang up / accept are the same red and green in both themes. -->
      <SolidColorBrush x:Key="OmniCallHangUpBrush" Color="#E5484D" />
      <SolidColorBrush x:Key="OmniCallAcceptBrush" Color="#30A46C" />

      <!-- The control-bar button (CallButton): circle + caption; IsOn = filled circle (camera, screen on);
           IsOn with IsWarning = a red-tinted circle (the microphone is off: the other side does not hear
           you — it must not look like "camera on", owner's night pass 2026-10-13). -->
      <Style TargetType="calls:CallButton">
        <Setter Property="Background" Value="{ThemeResource OmniCallControlBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OmniCallTextBrush}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="calls:CallButton">
              <StackPanel x:Name="Root" Width="76" Background="Transparent" Spacing="7">
                <Grid Width="56" Height="56" HorizontalAlignment="Center">
                  <Ellipse x:Name="Fill" Fill="{TemplateBinding Background}" />
                  <Ellipse x:Name="OnFill" Fill="{ThemeResource OmniCallControlOnBrush}" Opacity="0" />
                  <Ellipse x:Name="WarnFill" Fill="{ThemeResource OmniCallControlWarnBrush}" Opacity="0" />
                  <Ellipse x:Name="Hover" Fill="{ThemeResource OmniCallTextBrush}" Opacity="0" />
                  <ContentPresenter
                    x:Name="Icon"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Content}"
                    Foreground="{TemplateBinding Foreground}" />
                </Grid>
                <TextBlock
                  HorizontalAlignment="Center"
                  FontSize="12"
                  Foreground="{ThemeResource OmniCallTextBrush}"
                  Opacity="0.82"
                  Text="{TemplateBinding Caption}"
                  TextAlignment="Center"
                  TextTrimming="CharacterEllipsis" />
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="Hover.Opacity" Value="0.1" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters>
                        <Setter Target="Hover.Opacity" Value="0.18" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <VisualState.Setters>
                        <Setter Target="Root.Opacity" Value="0.4" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="OnStates">
                    <VisualState x:Name="Off" />
                    <VisualState x:Name="On">
                      <VisualState.Setters>
                        <Setter Target="OnFill.Opacity" Value="1" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource OmniCallControlOnIconBrush}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="OnWarning">
                      <VisualState.Setters>
                        <Setter Target="WarnFill.Opacity" Value="1" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource OmniCallControlWarnIconBrush}" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
              </StackPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Settings and Diagnostics pages (2026-10-13): groups of flat rows — a small group title,
           rows with the name on the left and the control on the right, a hairline under each row
           (Features/Shared/SettingRow.cs). -->
      <Style x:Key="SettingGroupTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,24,0,2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OmniAccentBrush}" />
      </Style>

      <!-- The line under a setting, a status, an explanation: smaller and quieter than the setting. -->
      <Style x:Key="SettingCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Opacity" Value="0.66" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
      </Style>

      <!-- A row built in code (a courier, a relay, a DHT entry node): the same line as SettingRow. -->
      <Style x:Key="SettingListRowStyle" TargetType="Border">
        <Setter Property="Padding" Value="0,11,0,11" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
      </Style>


      <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.72" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
